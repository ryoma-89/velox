#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;

struct RayResult {
    uint kind;
    float distance;
    uint instanceIndex;
    uint primitiveIndex;
    uint geometryIndex;
};

layout(std430, set = 0, binding = 1) writeonly buffer Output {
    RayResult rays[];
} outputBuffer;

void main() {
    uint index = gl_GlobalInvocationID.x;
    const vec3 origins[] = vec3[](vec3(0.25, 0.25, 1.0), vec3(4.25, 0.25, 1.0),
                                  vec3(4.25, 0.25, 1.0), vec3(2.5, 1.5, 1.0),
                                  vec3(1.25, 0.25, 1.0));
    uint mask = index == 2u ? 1u : 0xffu;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, mask,
                          origins[index], 0.0, vec3(0.0, 0.0, -1.0), 10.0);
    while (rayQueryProceedEXT(query)) {
    }

    uint kind = rayQueryGetIntersectionTypeEXT(query, true);
    RayResult result = RayResult(kind, 0.0, 0u, 0u, 0u);
    if (kind == gl_RayQueryCommittedIntersectionTriangleEXT) {
        result.distance = rayQueryGetIntersectionTEXT(query, true);
        result.instanceIndex = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        result.primitiveIndex = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
        result.geometryIndex = uint(rayQueryGetIntersectionGeometryIndexEXT(query, true));
    }
    outputBuffer.rays[index] = result;
}
