#version 460
#extension GL_EXT_ray_query : require

// 1 画素につき主レイ 1 本（最も近い交差）と、命中したときの影レイ 1 本（最初の交差で終了）。
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(std430, set = 0, binding = 1) writeonly buffer Output {
    uint pixels[];
} outputBuffer;
layout(push_constant) uniform Params {
    uint width;
    uint height;
    float extent;  // シーンの一辺の長さ
    uint pad;
} params;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= params.width || pixel.y >= params.height) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(params.width, params.height);
    vec3 target = vec3(uv.x * params.extent, uv.y * params.extent, 0.0);
    vec3 origin = vec3(params.extent * 0.5, params.extent * 0.5, params.extent * 0.75);
    vec3 direction = normalize(target - origin);

    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, 0xff, origin, 0.0, direction,
                          params.extent * 4.0);
    while (rayQueryProceedEXT(query)) {
    }
    uint value = 0u;
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        float t = rayQueryGetIntersectionTEXT(query, true);
        uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
        vec3 hit = origin + direction * t;
        vec3 light = normalize(vec3(0.3, 0.2, 1.0));
        rayQueryEXT shadow;
        rayQueryInitializeEXT(shadow, scene,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xff,
                              hit + light * 0.001, 0.0, light, params.extent * 4.0);
        while (rayQueryProceedEXT(shadow)) {
        }
        bool shadowed = rayQueryGetIntersectionTypeEXT(shadow, true) != gl_RayQueryCommittedIntersectionNoneEXT;
        value = ((instance * 0x9E3779B1u) ^ (primitive + 1u)) & 0x7fffffffu;
        if (shadowed) value |= 0x80000000u;
    }
    outputBuffer.pixels[pixel.y * params.width + pixel.x] = value;
}
