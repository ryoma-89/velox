#version 460
#extension GL_EXT_ray_tracing : require

// ray_bench.comp と同じ主レイと影レイを Ray Tracing Pipeline で出す。
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(std430, set = 0, binding = 1) writeonly buffer Output {
    uint pixels[];
} outputBuffer;
layout(push_constant) uniform Params {
    uint width;
    uint height;
    float extent;
    uint pad;
} params;

struct Primary {
    uint value;
    float t;  // 負は非命中
};
layout(location = 0) rayPayloadEXT Primary primary;
layout(location = 1) rayPayloadEXT uint shadowed;

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(params.width, params.height);
    vec3 target = vec3(uv.x * params.extent, uv.y * params.extent, 0.0);
    vec3 origin = vec3(params.extent * 0.5, params.extent * 0.5, params.extent * 0.75);
    vec3 direction = normalize(target - origin);
    primary.value = 0u;
    primary.t = -1.0;
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xff, 0, 1, 0, origin, 0.0, direction, params.extent * 4.0, 0);
    uint value = primary.value;
    if (primary.t >= 0.0) {
        vec3 hit = origin + direction * primary.t;
        vec3 light = normalize(vec3(0.3, 0.2, 1.0));
        shadowed = 1u;
        traceRayEXT(scene,
                    gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                    0xff, 0, 1, 1, hit + light * 0.001, 0.0, light, params.extent * 4.0, 1);
        if (shadowed != 0u) value |= 0x80000000u;
    }
    outputBuffer.pixels[pixel.y * params.width + pixel.x] = value;
}
