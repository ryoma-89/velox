#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Instances {
    vec4 data[];
} inst;

layout(push_constant) uniform CompPush {
    uint count;
    uint seed;
    float timeSec;
    uint pad;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uint h = (i * 747796405u + 2891336453u) ^ (pc.seed * 277803737u);
    h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
    h = (h >> 22u) ^ h;

    float fx = float(h & 1023u) / 1023.0;
    float fy = float((h >> 10u) & 1023u) / 1023.0;
    float fz = float((h >> 20u) & 1023u) / 1023.0;

    float angle = pc.timeSec * (0.4 + 0.6 * fx) + float(i % 97u) * 0.064;
    float x = (fx * 2.0 - 1.0) * 1.4 + 0.12 * cos(angle);
    float y = (fy * 2.0 - 1.0) * 0.9 + 0.12 * sin(angle);
    float z = 0.15 + fz * 0.75;
    float scale = 0.018 + 0.024 * fract(fx + fy);

    inst.data[i * 2u + 0u] = vec4(x, y, z, scale);
    inst.data[i * 2u + 1u] = vec4(0.25 + 0.75 * fx, 0.25 + 0.75 * fy, 0.25 + 0.75 * fz, angle);
}
