#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model

#ifdef VELOX_INT8
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#define INPUT int8_t
#define ACC int
#else
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define INPUT float16_t
#ifdef VELOX_FP16_ACCUM
#define ACC float16_t
#else
#define ACC float
#endif
#endif

layout(constant_id = 0) const int M = 16;
layout(constant_id = 1) const int N = 16;
layout(constant_id = 2) const int K = 16;
layout(local_size_x_id = 3) in;
layout(set = 0, binding = 0, std430) readonly buffer MatrixA { INPUT a[]; };
layout(set = 0, binding = 1, std430) readonly buffer MatrixB { INPUT b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer MatrixC { ACC c[]; };
layout(push_constant) uniform MatrixShape {
    uint rows;
    uint columns;
    uint depth;
    uint firstBatch;
} shape;

void main() {
    uint row = gl_WorkGroupID.y * M;
    uint col = gl_WorkGroupID.x * N;
    uint batch = shape.firstBatch + gl_WorkGroupID.z;
    uint aBase = batch * shape.rows * shape.depth;
    uint bBase = batch * shape.depth * shape.columns;
    uint cBase = batch * shape.rows * shape.columns;
    coopmat<INPUT, gl_ScopeSubgroup, M, K, gl_MatrixUseA> tileA;
    coopmat<INPUT, gl_ScopeSubgroup, K, N, gl_MatrixUseB> tileB;
    coopmat<ACC, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> sum =
        coopmat<ACC, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(ACC(0));
    for (uint offset = 0; offset < shape.depth; offset += K) {
        coopMatLoad(tileA, a, aBase + row * shape.depth + offset, shape.depth,
                    gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(tileB, b, bBase + offset * shape.columns + col, shape.columns,
                    gl_CooperativeMatrixLayoutRowMajor);
        sum = coopMatMulAdd(tileA, tileB, sum);
    }
    coopMatStore(sum, c, cBase + row * shape.columns + col, shape.columns,
                 gl_CooperativeMatrixLayoutRowMajor);
}
