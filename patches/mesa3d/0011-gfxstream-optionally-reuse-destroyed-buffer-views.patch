+        auto it = mBufferViewsFree.find(key);
+        if (it != mBufferViewsFree.end() && !it->second.empty()) {
+            const VkBufferView view = it->second.back();
+            it->second.pop_back();
+            if (it->second.empty()) mBufferViewsFree.erase(it);
+            --mBufferViewsFreeCount;
+            mBufferViewsInUse.emplace(view, key);
+            *pView = view;
+            if (mFenceStats) mStatBufferViewReused.fetch_add(1, std::memory_order_relaxed);
+            return VK_SUCCESS;
+        }
+    }
+    const VkResult result =
+        enc->vkCreateBufferView(device, pCreateInfo, pAllocator, pView, true /* do lock */);
+    if (result == VK_SUCCESS) {
+        std::lock_guard<std::mutex> lock(mBufferViewLock);
+        mBufferViewsInUse.emplace(*pView, key);
+        ++mBufferViewCountByBuffer[key.buffer];
+    }
+    return result;
+}
+
+void ResourceTracker::on_vkDestroyBufferView(void* context, VkDevice device, VkBufferView bufferView,
+                                             const VkAllocationCallbacks* pAllocator) {
+    VkEncoder* enc = (VkEncoder*)context;
+    {
+        std::lock_guard<std::mutex> lock(mBufferViewLock);
+        auto it = mBufferViewsInUse.find(bufferView);
+        if (it != mBufferViewsInUse.end()) {
+            const BufferViewKey key = it->second;
+            mBufferViewsInUse.erase(it);
+            if (mBufferViewsFreeCount < kMaxCachedBufferViews) {
+                mBufferViewsFree[key].push_back(bufferView);
+                ++mBufferViewsFreeCount;
+                return;
+            }
+            auto count = mBufferViewCountByBuffer.find(key.buffer);
+            if (count != mBufferViewCountByBuffer.end() && --count->second == 0) {
+                mBufferViewCountByBuffer.erase(count);
+            }
+        }
+    }
+    enc->vkDestroyBufferView(device, bufferView, pAllocator, true /* do lock */);
+}
+
+// Destroys the cached views of `buffer` (or of every buffer of `device` when buffer is null) and
+// stops tracking views of it that are still in use, so that they are destroyed normally later.
+// Must run before the buffer or device is destroyed: the host may reuse the handle values.
+void ResourceTracker::releaseCachedBufferViews(void* context, VkDevice device, VkBuffer buffer) {
+    if (!mBufferViewCache) return;
+    VkEncoder* enc = (VkEncoder*)context;
+    std::vector<VkBufferView> release;
+    {
+        std::lock_guard<std::mutex> lock(mBufferViewLock);
+        if (buffer != VK_NULL_HANDLE && !mBufferViewCountByBuffer.count(buffer)) return;
+        auto matches = [&](const BufferViewKey& key) {
+            return buffer != VK_NULL_HANDLE ? key.buffer == buffer : key.device == device;
+        };
+        for (auto it = mBufferViewsFree.begin(); it != mBufferViewsFree.end();) {
+            if (matches(it->first)) {
+                mBufferViewsFreeCount -= it->second.size();
+                release.insert(release.end(), it->second.begin(), it->second.end());
+                mBufferViewCountByBuffer.erase(it->first.buffer);
+                it = mBufferViewsFree.erase(it);
+            } else {
+                ++it;
+            }
+        }
+        for (auto it = mBufferViewsInUse.begin(); it != mBufferViewsInUse.end();) {
+            if (matches(it->second)) {
+                mBufferViewCountByBuffer.erase(it->second.buffer);
+                it = mBufferViewsInUse.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    for (VkBufferView view : release) enc->vkDestroyBufferView(device, view, nullptr, true);
+}
