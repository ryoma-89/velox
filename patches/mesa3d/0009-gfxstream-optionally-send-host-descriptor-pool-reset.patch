+// Velox: same packet as the generated vkResetDescriptorPool, but the 4-byte VkResult the host
+// writes back is consumed by the next readback() on this stream instead of being waited for here.
+// The command is flushed immediately: with process-wide sequence numbers, an unflushed command
+// would stall every other thread's later commands on the host.
+int32_t VkEncoder::vkResetDescriptorPoolDeferredStatusVELOX(VkDevice device,
+                                                             VkDescriptorPool descriptorPool,
+                                                             VkDescriptorPoolResetFlags flags) {
+    const bool queueSubmitWithCommandsEnabled =
+        sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
+    if (!queueSubmitWithCommandsEnabled) {
+        GFXSTREAM_FATAL("vkResetDescriptorPoolDeferredStatusVELOX needs sequence numbers");
+    }
+    auto stream = mImpl->stream();
+    auto pool = mImpl->pool();
+    const uint32_t packetSize = 4 + 4 + 4 + 8 + 8 + sizeof(VkDescriptorPoolResetFlags);
+    uint8_t* streamPtr = stream->reserve(packetSize);
+    const uint32_t opcode = OP_vkResetDescriptorPool;
+    const uint32_t seqno = ResourceTracker::nextSeqno();
+    const uint64_t hostDevice = gfxstream_vk_device_to_host_u64(device);
+    const uint64_t hostPool = gfxstream_vk_descriptor_pool_to_host_u64(descriptorPool);
+    memcpy(streamPtr, &opcode, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    memcpy(streamPtr, &packetSize, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    memcpy(streamPtr, &seqno, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    memcpy(streamPtr, &hostDevice, 8);
+    streamPtr += 8;
+    memcpy(streamPtr, &hostPool, 8);
+    streamPtr += 8;
+    memcpy(streamPtr, &flags, sizeof(VkDescriptorPoolResetFlags));
+    stream->flush();
+    stream->deferStatusReply();
+    // Bound the replies left in the host-to-guest channel.
+    if (stream->deferredReplies() >= gfxstream::guest::IOStream::kMaxDeferredReplies &&
+        !stream->drainDeferredReplies()) {
+        GFXSTREAM_FATAL("FATAL: could not read deferred status replies");
+    }
+    ++encodeCount;
+    if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
+        pool->freeAll();
+        stream->clearPool();
+    }
+    return stream->takeDeferredReplyError();
+}
