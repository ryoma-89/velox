index 0000000..7d207d3
--- /dev/null
+++ b/src/gfxstream/codegen/scripts/cereal/stypeunion.py
@@ -0,0 +1,40 @@
+# Copyright 2026 The Android Open Source Project
+# SPDX-License-Identifier: MIT
+
+from .common.vulkantypes import iterateVulkanType
+
+STYPE_SELECTED_UNIONS = {
+    "VkAccelerationStructureGeometryDataKHR",
+}
+
+
+def iterateUnion(typeInfo, structInfo, codegen, parentVar, peekExpr=None):
+    members = structInfo.members
+    stypes = []
+    if structInfo.name in STYPE_SELECTED_UNIONS:
+        for member in members:
+            memberStruct = typeInfo.structs.get(member.typeName)
+            if memberStruct is None or memberStruct.structEnumExpr is None:
+                stypes = []
+                break
+            stypes.append(memberStruct.structEnumExpr)
+    if not stypes:
+        iterateVulkanType(typeInfo, members[0], codegen)
+        return
+    cgen = codegen.cgen
+    if peekExpr is None:
+        selector = "%s->%s.sType" % (parentVar, members[0].paramName)
+    else:
+        cgen.stmt("VkStructureType unionSType")
+        cgen.stmt("memcpy(&unionSType, %s, sizeof(VkStructureType))" % peekExpr)
+        selector = "unionSType"
+    for index in range(1, len(members)):
+        if index == 1:
+            cgen.beginIf("%s == %s" % (selector, stypes[index]))
+        else:
+            cgen.beginElse("%s == %s" % (selector, stypes[index]))
+        iterateVulkanType(typeInfo, members[index], codegen)
+        cgen.endIf()
+    cgen.beginElse()
+    iterateVulkanType(typeInfo, members[0], codegen)
+    cgen.endIf()
