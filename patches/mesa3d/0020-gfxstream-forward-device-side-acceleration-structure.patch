+// Velox: the generated encoder cannot send ppGeometries or the array of range info pointers,
+// so geometries are always sent in pGeometries and the range infos are flattened in geometry
+// order for vkCmdBuildAccelerationStructuresFlatGOOGLE.
+static void velox_flatten_build_infos(
+    uint32_t infoCount, const VkAccelerationStructureBuildGeometryInfoKHR* pInfos,
+    std::vector<VkAccelerationStructureBuildGeometryInfoKHR>& infos,
+    std::vector<std::vector<VkAccelerationStructureGeometryKHR>>& geometries) {
+    infos.assign(pInfos, pInfos + infoCount);
+    geometries.resize(infoCount);
+    for (uint32_t i = 0; i < infoCount; ++i) {
+        if (infos[i].ppGeometries) {
+            geometries[i].reserve(infos[i].geometryCount);
+            for (uint32_t g = 0; g < infos[i].geometryCount; ++g) {
+                geometries[i].push_back(*infos[i].ppGeometries[g]);
+            }
+            infos[i].pGeometries = geometries[i].data();
+            infos[i].ppGeometries = nullptr;
+        }
+    }
+}
+
+void gfxstream_vk_CmdBuildAccelerationStructuresKHR(
+    VkCommandBuffer commandBuffer, uint32_t infoCount,
+    const VkAccelerationStructureBuildGeometryInfoKHR* pInfos,
+    const VkAccelerationStructureBuildRangeInfoKHR* const* ppBuildRangeInfos) {
+    MESA_TRACE_SCOPE("vkCmdBuildAccelerationStructuresKHR");
+    std::vector<VkAccelerationStructureBuildGeometryInfoKHR> infos;
+    std::vector<std::vector<VkAccelerationStructureGeometryKHR>> geometries;
+    velox_flatten_build_infos(infoCount, pInfos, infos, geometries);
+    std::vector<VkAccelerationStructureBuildRangeInfoKHR> ranges;
+    for (uint32_t i = 0; i < infoCount; ++i) {
+        ranges.insert(ranges.end(), ppBuildRangeInfos[i],
+                      ppBuildRangeInfos[i] + pInfos[i].geometryCount);
+    }
+    auto vkEnc = gfxstream::vk::ResourceTracker::getCommandBufferEncoder(commandBuffer);
+    vkEnc->vkCmdBuildAccelerationStructuresFlatGOOGLE(commandBuffer, infoCount, infos.data(),
+                                                      (uint32_t)ranges.size(), ranges.data(),
+                                                      true /* do lock */);
+}
+
+void gfxstream_vk_GetAccelerationStructureBuildSizesKHR(
+    VkDevice device, VkAccelerationStructureBuildTypeKHR buildType,
+    const VkAccelerationStructureBuildGeometryInfoKHR* pBuildInfo,
+    const uint32_t* pMaxPrimitiveCounts, VkAccelerationStructureBuildSizesInfoKHR* pSizeInfo) {
+    MESA_TRACE_SCOPE("vkGetAccelerationStructureBuildSizesKHR");
+    std::vector<VkAccelerationStructureBuildGeometryInfoKHR> infos;
+    std::vector<std::vector<VkAccelerationStructureGeometryKHR>> geometries;
+    velox_flatten_build_infos(1, pBuildInfo, infos, geometries);
+    auto vkEnc = gfxstream::vk::ResourceTracker::getThreadLocalEncoder();
+    vkEnc->vkGetAccelerationStructureBuildSizesKHR(device, buildType, infos.data(),
+                                                   pMaxPrimitiveCounts, pSizeInfo,
+                                                   true /* do lock */);
+}
