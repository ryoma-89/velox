 }
 
+void ResourceTracker::mappedMemoryRangeTransform_tohost(VkMappedMemoryRange* range) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    const auto memory = info_VkDeviceMemory.find(range->memory);
+    if (memory == info_VkDeviceMemory.end() || !memory->second.coherentMemory) return;
+
+    const auto& info = memory->second;
+    const auto& block = info.coherentMemory;
+    const VkDeviceSize offset = range->offset;
+    range->memory = block->getDeviceMemory();
+    range->offset += info.coherentMemoryOffset;
+    if (offset >= info.allocationSize) return;
+    const VkDeviceSize tail = info.allocationSize - offset;
+    if (range->size == VK_WHOLE_SIZE) range->size = tail;
+    if (range->size != tail || !usingDirectMapping()) return;
+
+    // The end of a guest allocation can be in the middle of a native non-coherent atom.
+    // Only extend into padding owned by this allocation, never the next suballocation.
+    const auto device = info_VkDevice.find(info.device);
+    if (device == info_VkDevice.end()) return;
+    const VkDeviceSize atom = device->second.props.limits.nonCoherentAtomSize;
+    if (!atom || atom > (VkDeviceSize{1} << CoherentMemory::kSuballocationAlignmentBits) ||
+        range->offset % atom || range->offset > block->getSize() ||
+        tail > block->getSize() - range->offset) return;
+    const VkDeviceSize padding = (atom - tail % atom) % atom;
+    if (padding <= block->getSize() - range->offset - tail) range->size += padding;
+}
