+// Flushes the command just encoded and leaves its 4-byte status for the next readback().
+int32_t VkEncoder::finishDeferredStatusCommandVELOX() {
+    auto stream = mImpl->stream();
+    auto pool = mImpl->pool();
     stream->flush();
     stream->deferStatusReply();
     // Bound the replies left in the host-to-guest channel.
@@ -139,3 +147,34 @@ int32_t VkEncoder::vkResetDescriptorPoolDeferredStatusVELOX(VkDevice device,
     }
     return stream->takeDeferredReplyError();
 }
+
+// Velox: the generated vkResetFences packet without waiting for the status (see above).
+int32_t VkEncoder::vkResetFencesDeferredStatusVELOX(VkDevice device, uint32_t fenceCount,
+                                                    const VkFence* pFences) {
+    const bool queueSubmitWithCommandsEnabled =
+        sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
+    if (!queueSubmitWithCommandsEnabled) {
+        GFXSTREAM_FATAL("vkResetFencesDeferredStatusVELOX needs sequence numbers");
+    }
+    auto stream = mImpl->stream();
+    const uint32_t packetSize = 4 + 4 + 4 + 8 + 4 + 8 * fenceCount;
+    uint8_t* streamPtr = stream->reserve(packetSize);
+    const uint32_t opcode = OP_vkResetFences;
+    const uint32_t seqno = ResourceTracker::nextSeqno();
+    const uint64_t hostDevice = gfxstream_vk_device_to_host_u64(device);
+    memcpy(streamPtr, &opcode, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    memcpy(streamPtr, &packetSize, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    memcpy(streamPtr, &seqno, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    memcpy(streamPtr, &hostDevice, 8);
+    streamPtr += 8;
+    memcpy(streamPtr, &fenceCount, sizeof(uint32_t));
+    streamPtr += sizeof(uint32_t);
+    for (uint32_t k = 0; k < fenceCount; ++k) {
+        const uint64_t hostFence = gfxstream_vk_fence_to_host_u64(pFences[k]);
+        memcpy(streamPtr + k * 8, &hostFence, sizeof(uint64_t));
+    }
+    return finishDeferredStatusCommandVELOX();
+}
