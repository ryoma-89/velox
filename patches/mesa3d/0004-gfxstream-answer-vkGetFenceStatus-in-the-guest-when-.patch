+void ResourceTracker::maybeLogFenceStats() {
+    if (!mFenceStats) return;
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const uint64_t now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    uint64_t last = mStatStatsLastNs.load(std::memory_order_relaxed);
+    if (now - last < 10000000000ull) return;
+    if (!mStatStatsLastNs.compare_exchange_strong(last, now)) return;
+    mesa_logi(
+        "velox-fence-stats: submitsWithFence=%llu getFenceStatus=%llu rpc=%llu localReady=%llu "
+        "localNotReady=%llu hintsArmed=%llu waitForFences=%llu waitRpc=%llu poolResets=%llu",
+        (unsigned long long)mStatFenceSubmits.load(), (unsigned long long)mStatFenceStatusCalls.load(),
+        (unsigned long long)mStatFenceStatusRpc.load(),
+        (unsigned long long)mStatFenceStatusLocalReady.load(),
+        (unsigned long long)mStatFenceStatusLocalNotReady.load(),
+        (unsigned long long)mStatHintsArmed.load(),
+        (unsigned long long)mStatWaitForFencesCalls.load(),
+        (unsigned long long)mStatWaitForFencesRpc.load(),
+        (unsigned long long)mStatPoolResets.load());
+}
+
+void ResourceTracker::clearFenceStatusHintLocked(VkFence_Info& info) {
+#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
+    if (info.hintFd >= 0) mSyncHelper->close(info.hintFd);
+#endif
+    info.hintFd = -1;
+    info.signaledConfirmed = false;
+    ++info.hintGeneration;
+}
+
+// After a submission with |fence|, ask the host to signal a goldfish sync fd once its wait on the
+// VkFence returns. The host signals unconditionally, also on timeout (5 s) or error, and sync
+// points of one timeline signal in order, so the fd only tells that the fence may be signaled;
+// on_vkGetFenceStatus confirms with the host before reporting VK_SUCCESS.
+void ResourceTracker::armFenceStatusHint(VkFence fence, uint64_t seq) {
+#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
+    if (!mFenceStatusHints || fence == VK_NULL_HANDLE) return;
+    ensureSyncDeviceFd();
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    if (mSyncDeviceFd < 0) {
+        mFenceStatusHints = false;
+        return;
+    }
+    auto it = info_VkFence.find(fence);
+    if (it == info_VkFence.end()) return;
+    auto& info = it->second;
+    if (info.external) return;
+    clearFenceStatusHintLocked(info);
+    // Type byte 0x56 (GOLDFISH_SYNC_VULKAN_FENCE_HINT on the host) and the fence's submission
+    // number above it: the host signals once that submission completed, was reset or superseded.
+    constexpr uint64_t kGoldfishSyncVulkanFenceHint = 0x56;
+    int fd = -1;
+    if (goldfish_sync_queue_work(mSyncDeviceFd, gfxstream_vk_fence_to_host_u64(fence),
+                                 (info.submitCount << 8) | kGoldfishSyncVulkanFenceHint,
+                                 &fd) != 0 ||
+        fd < 0) {
+        return;
+    }
+    info.hintFd = fd;
+    info.hintSeq = seq;
+    mStatHintsArmed.fetch_add(1, std::memory_order_relaxed);
+#else
+    (void)fence;
+    (void)seq;
+#endif
+}
+
 void ResourceTracker::unregister_VkFence(VkFence fence) {
     std::lock_guard<std::recursive_mutex> lock(mLock);
     auto it = info_VkFence.find(fence);
@@ -1244,6 +1311,7 @@ void ResourceTracker::unregister_VkFence(VkFence fence) {
         mSyncHelper->close(*fenceInfo.syncFd);
     }
 #endif
+    clearFenceStatusHintLocked(fenceInfo);
 
     info_VkFence.erase(fence);
 }
@@ -1489,6 +1557,18 @@ void ResourceTracker::setupCaps(uint32_t& noRenderControlEnc) {
     noRenderControlEnc = mCaps.vulkanCapset.noRenderControlEnc;
 }
 
+// For A/B measurements: debug.velox.fence_hint=0 (Android) or GFXSTREAM_FENCE_STATUS_HINTS=false
+// turns the fence status hints off.
+static bool fenceStatusHintsAllowed() {
+#if DETECT_OS_ANDROID
+    char value[PROP_VALUE_MAX] = {};
+    if (__system_property_get("debug.velox.fence_hint", value) > 0) {
+        return strcmp(value, "0") != 0 && strcmp(value, "false") != 0;
+    }
+#endif
+    return debug_get_bool_option("GFXSTREAM_FENCE_STATUS_HINTS", true);
+}
+
 // For A/B measurements: debug.velox.defer_pool_reset=0 (Android) or
 // GFXSTREAM_DEFERRED_DESCRIPTOR_POOL_RESET=false turns the deferred descriptor pool reset off.
 static bool deferredDescriptorPoolResetAllowed() {
@@ -1565,6 +1645,20 @@ void ResourceTracker::setupFeatures(const struct GfxStreamVkFeatureInfo* feature
         mFeatureInfo.hasVulkanQueueSubmitWithCommands &&
         mFeatureInfo.hasVulkanDeferredDescriptorPoolReset && deferredDescriptorPoolResetAllowed();
 
+#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
+    // Hints use the goldfish sync device (pipe/ASG transports); virtio-gpu native sync has its own
+    // fence objects.
+    mFenceStatusHints = mFeatureInfo.hasVulkanFenceStatusHint &&
+                        !mFeatureInfo.hasVirtioGpuNativeSync && fenceStatusHintsAllowed();
+#if DETECT_OS_ANDROID
+    {
+        char value[PROP_VALUE_MAX] = {};
+        mFenceStats = __system_property_get("debug.velox.fence_stats", value) > 0 &&
+                      strcmp(value, "1") == 0;
+    }
+#endif
+#endif
+
     mFeatureInfo.setupComplete = true;
 }
 
@@ -4965,6 +5059,10 @@ VkResult ResourceTracker::on_vkResetFences(void* context, VkResult, VkDevice dev
     // on fence reset, close the fence fd
     // and act like we need to GetFenceFdKHR/ImportFenceFdKHR again
     std::lock_guard<std::recursive_mutex> lock(mLock);
+    for (uint32_t i = 0; i < fenceCount; ++i) {
+        auto it = info_VkFence.find(pFences[i]);
+        if (it != info_VkFence.end()) clearFenceStatusHintLocked(it->second);
+    }
 #if DETECT_OS_LINUX
     for (uint32_t i = 0; i < fenceCount; ++i) {
         VkFence fence = pFences[i];
@@ -5139,6 +5237,8 @@ VkResult ResourceTracker::on_vkGetFenceFdKHR(void* context, VkResult, VkDevice d
 VkResult ResourceTracker::on_vkGetFenceStatus(void* context, VkResult input_result, VkDevice device,
                                               VkFence fence) {
     VkEncoder* enc = (VkEncoder*)context;
+    mStatFenceStatusCalls.fetch_add(1, std::memory_order_relaxed);
+    maybeLogFenceStats();
 
 #if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
     {
@@ -5163,16 +5263,130 @@ VkResult ResourceTracker::on_vkGetFenceStatus(void* context, VkResult input_resu
             int syncFdSignaled = mSyncHelper->wait(*fenceInfo.syncFd, /*timeout=*/0) == 0;
             return syncFdSignaled ? VK_SUCCESS : VK_NOT_READY;
         }
+
+        // Fence status hint. A fence never reports VK_SUCCESS before the host does:
+        //  - confirmed: the host returned VK_SUCCESS for this submission (sticky until reset)
+        //  - hint fd not signaled and no host completion observed since it was armed: the host is
+        //    still waiting on the VkFence, so the fence is unsignaled -> VK_NOT_READY locally
+        //  - otherwise ask the host (below)
+        if (fenceInfo.signaledConfirmed) {
+            mStatFenceStatusLocalReady.fetch_add(1, std::memory_order_relaxed);
+            return VK_SUCCESS;
+        }
+        if (fenceInfo.hintFd >= 0 &&
+            fenceInfo.hintSeq > mObservedSeq.load(std::memory_order_acquire) &&
+            mSyncHelper->wait(fenceInfo.hintFd, /*timeout=*/0) != 0) {
+            mStatFenceStatusLocalNotReady.fetch_add(1, std::memory_order_relaxed);
+            return VK_NOT_READY;
+        }
     }
 #endif
 
-    return enc->vkGetFenceStatus(device, fence, /*doLock=*/true);
+    uint64_t seqBefore = submittedSeq();
+    uint64_t generation = 0;
+    uint64_t hintSeq = 0;
+    bool hinted = false;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkFence.find(fence);
+        if (it != info_VkFence.end()) {
+            generation = it->second.hintGeneration;
+            hinted = it->second.hintFd >= 0;
+            hintSeq = it->second.hintSeq;
+        }
+    }
+    VkResult res = enc->vkGetFenceStatus(device, fence, /*doLock=*/true);
+    mStatFenceStatusRpc.fetch_add(1, std::memory_order_relaxed);
+    // The fence's own submission (and everything before it on its queue) completed. Without a
+    // hint the submission number is unknown: assume every submission made before this call.
+    if (res == VK_SUCCESS) noteHostCompletion(hinted ? hintSeq : seqBefore);
+    if (res == VK_SUCCESS && !hinted && mFenceStatusHints) {
+        // A signaled fence stays signaled until vkResetFences (which clears this).
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkFence.find(fence);
+        if (it != info_VkFence.end() && it->second.hintGeneration == generation &&
+            !it->second.external && !it->second.syncFd) {
+            it->second.signaledConfirmed = true;
+        }
+    }
+    if (!hinted && res == VK_NOT_READY && mFenceStatusHints) {
+        // First poll of this submission that found it unsignaled: arm a hint so that the next
+        // polls are answered locally.
+        uint64_t seq = 0;
+        bool arm = false;
+        {
+            std::lock_guard<std::recursive_mutex> lock(mLock);
+            auto it = info_VkFence.find(fence);
+            if (it != info_VkFence.end() && it->second.hintGeneration == generation &&
+                it->second.submitCount > 0 && !it->second.external && !it->second.syncFd) {
+                seq = it->second.lastSubmitSeq;
+                arm = true;
+            }
+        }
+        if (arm) armFenceStatusHint(fence, seq);
+    }
+    if (hinted) {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkFence.find(fence);
+        if (it != info_VkFence.end() && it->second.hintGeneration == generation) {
+            auto& info = it->second;
+            if (res == VK_SUCCESS) {
+                info.signaledConfirmed = true;
+            } else if (res == VK_NOT_READY) {
+                // The host has not signaled the fence although the hint fired (host wait
+                // timeout, out-of-order completion on the shared timeline) or an observation
+                // covered its submission. Arm a new hint if this one already fired; until it
+                // fires, polls keep asking the host while the observation covers the submission.
+                if (mSyncHelper->wait(info.hintFd, 0) == 0) {
+                    armFenceStatusHint(fence, info.hintSeq);  // mLock is recursive
+                }
+            }
+        }
+    }
+    return res;
 }
 
 VkResult ResourceTracker::on_vkWaitForFences(void* context, VkResult, VkDevice device,
                                              uint32_t fenceCount, const VkFence* pFences,
                                              VkBool32 waitAll, uint64_t timeout) {
 #if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
+    mStatWaitForFencesCalls.fetch_add(1, std::memory_order_relaxed);
+    if (mFenceStatusHints && fenceCount > 0) {
+        // Fences confirmed since their last reset need no host wait. A zero timeout is a status
+        // query: answer it with the same rules as vkGetFenceStatus.
+        bool allHintable = true;
+        uint32_t confirmed = 0;
+        {
+            std::lock_guard<std::recursive_mutex> lock(mLock);
+            for (uint32_t i = 0; i < fenceCount; ++i) {
+                auto it = info_VkFence.find(pFences[i]);
+                if (it == info_VkFence.end() || it->second.external || it->second.syncFd) {
+                    allHintable = false;
+                    break;
+                }
+                if (it->second.signaledConfirmed) ++confirmed;
+            }
+        }
+        if (allHintable) {
+            if ((waitAll && confirmed == fenceCount) || (!waitAll && confirmed > 0)) {
+                return VK_SUCCESS;
+            }
+            if (timeout == 0) {
+                uint32_t signaled = 0;
+                for (uint32_t i = 0; i < fenceCount; ++i) {
+                    VkResult r = on_vkGetFenceStatus(context, VK_SUCCESS, device, pFences[i]);
+                    if (r == VK_SUCCESS) {
+                        ++signaled;
+                        if (!waitAll) return VK_SUCCESS;
+                    } else if (r != VK_NOT_READY) {
+                        return r;
+                    }
+                }
+                return (waitAll && signaled == fenceCount) ? VK_SUCCESS : VK_TIMEOUT;
+            }
+        }
+    }
+
     (void)context;
     std::vector<int> fencesExternalSyncFds;
     std::vector<VkFence> fencesNonExternal;
@@ -5220,9 +5434,33 @@ VkResult ResourceTracker::on_vkWaitForFences(void* context, VkResult, VkDevice d
         auto hostConn = ResourceTracker::threadingCallbacks.hostConnectionGetFunc();
         auto vkEncoder = ResourceTracker::threadingCallbacks.vkEncoderGetFunc(hostConn);
         MESA_TRACE_SCOPE("vkWaitForFences to host");
-        return vkEncoder->vkWaitForFences(device, fencesNonExternal.size(),
-                                          fencesNonExternal.data(), waitAll, timeout,
-                                          true /* do lock */);
+        const uint64_t seqBefore = submittedSeq();
+        VkResult res = vkEncoder->vkWaitForFences(device, fencesNonExternal.size(),
+                                                  fencesNonExternal.data(), waitAll, timeout,
+                                                  true /* do lock */);
+        mStatWaitForFencesRpc.fetch_add(1, std::memory_order_relaxed);
+        if (res == VK_SUCCESS) {
+            // waitAll: every fence's submission completed and stays signaled until reset.
+            // waitAny: the application does not know which one, and may query each fence next,
+            // so treat all of them as covered.
+            uint64_t observed = 0;
+            std::lock_guard<std::recursive_mutex> relock(mLock);
+            for (VkFence f : fencesNonExternal) {
+                auto it = info_VkFence.find(f);
+                if (it == info_VkFence.end()) {
+                    observed = std::max(observed, seqBefore);
+                    continue;
+                }
+                auto& info = it->second;
+                if (waitAll && mFenceStatusHints && !info.external && !info.syncFd) {
+                    info.signaledConfirmed = true;
+                }
+                observed = std::max(observed, info.submitCount > 0 ? info.lastSubmitSeq
+                                                                   : seqBefore);
+            }
+            noteHostCompletion(observed);
+        }
+        return res;
     }
 
     return VK_SUCCESS;
@@ -5391,6 +5629,7 @@ VkResult ResourceTracker::on_vkResetDescriptorPool(void* context, VkResult, VkDe
         clearDescriptorPoolAndUnregisterDescriptorSets(context, device, descriptorPool);
         gfxstream_vk_descriptor_pool_from_handle(descriptorPool)
             ->allocInfo->resetEpoch.fetch_add(1, std::memory_order_release);
+        mStatPoolResets.fetch_add(1, std::memory_order_relaxed);
         return VK_SUCCESS;
     }
 
@@ -6782,9 +7021,25 @@ VkResult ResourceTracker::on_vkQueueSubmitTemplate(void* context, VkResult input
 #endif
 
     // The main queue submission
+    const uint64_t submitSeq = mSubmitSeq.fetch_add(1, std::memory_order_acq_rel) + 1;
     input_result = vkQueueSubmitEnc(enc, queue, submitCount, prunedSubmitInfos.data(), fence);
     if (input_result != VK_SUCCESS) return input_result;
 
+    if (fence != VK_NULL_HANDLE) {
+        // Count only. The hint is armed lazily by the first poll that finds the fence
+        // unsignaled (on_vkGetFenceStatus): arming costs a sync device request (a VM exit), which
+        // only pays off for fences that the application polls.
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkFence.find(fence);
+        if (it != info_VkFence.end()) {
+            auto& info = it->second;
+            ++info.submitCount;
+            info.lastSubmitSeq = submitSeq;
+            mStatFenceSubmits.fetch_add(1, std::memory_order_relaxed);
+            clearFenceStatusHintLocked(info);
+        }
+    }
+
     int externalFenceFdToSignal = -1;
 #if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
     {
@@ -6840,7 +7095,62 @@ VkResult ResourceTracker::on_vkQueueWaitIdle(void* context, VkResult, VkQueue qu
     VkEncoder* enc = (VkEncoder*)context;
 
     // now done waiting, get the host's opinion
-    return enc->vkQueueWaitIdle(queue, true /* do lock */);
+    const uint64_t seqBefore = submittedSeq();
+    VkResult res = enc->vkQueueWaitIdle(queue, true /* do lock */);
+    if (res == VK_SUCCESS) noteHostCompletion(seqBefore);
+    return res;
+}
+
+// The following calls tell the guest that queue work completed. Signal operations happen in
+// submission order, so after any of them a fence status hint that has not fired yet no longer
+// proves that its fence is unsignaled (see on_vkGetFenceStatus).
+VkResult ResourceTracker::on_vkDeviceWaitIdle(void* context, VkResult, VkDevice device) {
+    VkEncoder* enc = (VkEncoder*)context;
+    const uint64_t seqBefore = submittedSeq();
+    VkResult res = enc->vkDeviceWaitIdle(device, true /* do lock */);
+    if (res == VK_SUCCESS) noteHostCompletion(seqBefore);
+    return res;
+}
+
+VkResult ResourceTracker::on_vkWaitSemaphores(void* context, VkResult, VkDevice device,
+                                              const VkSemaphoreWaitInfo* pWaitInfo,
+                                              uint64_t timeout) {
+    VkEncoder* enc = (VkEncoder*)context;
+    const uint64_t seqBefore = submittedSeq();
+    VkResult res = enc->vkWaitSemaphores(device, pWaitInfo, timeout, true /* do lock */);
+    if (res == VK_SUCCESS) noteHostCompletion(seqBefore);
+    return res;
+}
+
+VkResult ResourceTracker::on_vkGetSemaphoreCounterValue(void* context, VkResult, VkDevice device,
+                                                        VkSemaphore semaphore, uint64_t* pValue) {
+    VkEncoder* enc = (VkEncoder*)context;
+    const uint64_t seqBefore = submittedSeq();
+    VkResult res = enc->vkGetSemaphoreCounterValue(device, semaphore, pValue, true /* do lock */);
+    if (res == VK_SUCCESS) noteHostCompletion(seqBefore);
+    return res;
+}
+
+VkResult ResourceTracker::on_vkGetQueryPoolResults(void* context, VkResult, VkDevice device,
+                                                   VkQueryPool queryPool, uint32_t firstQuery,
+                                                   uint32_t queryCount, size_t dataSize,
+                                                   void* pData, VkDeviceSize stride,
+                                                   VkQueryResultFlags flags) {
+    VkEncoder* enc = (VkEncoder*)context;
+    const uint64_t seqBefore = submittedSeq();
+    VkResult res = enc->vkGetQueryPoolResults(device, queryPool, firstQuery, queryCount, dataSize,
+                                              pData, stride, flags, true /* do lock */);
+    if (res == VK_SUCCESS || res == VK_NOT_READY) noteHostCompletion(seqBefore);
+    return res;
+}
+
+VkResult ResourceTracker::on_vkGetEventStatus(void* context, VkResult, VkDevice device,
+                                              VkEvent event) {
+    VkEncoder* enc = (VkEncoder*)context;
+    const uint64_t seqBefore = submittedSeq();
+    VkResult res = enc->vkGetEventStatus(device, event, true /* do lock */);
+    if (res == VK_EVENT_SET) noteHostCompletion(seqBefore);
+    return res;
 }
 
