+                                 const VkSemaphoreWaitInfo* pWaitInfo, uint64_t timeout);
+    VkResult on_vkGetSemaphoreCounterValue(void* context, VkResult input_result, VkDevice device,
+                                           VkSemaphore semaphore, uint64_t* pValue);
