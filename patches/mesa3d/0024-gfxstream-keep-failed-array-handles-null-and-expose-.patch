From e65a44fc0acae5d3bccf4ab9fd9f87d9f71f929f Mon Sep 17 00:00:00 2001
From: ryoma-89 <ryoma-89@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:31:16 +0900
Subject: [PATCH] gfxstream: keep failed array handles null and expose pipeline
 libraries with ray tracing pipelines

Velox-local change (biblioklept). Array outputs the host did not create (for
example a multi-pipeline call that returned an error) stay VK_NULL_HANDLE
instead of wrapping host handle 0; such a wrapper reached the host as a null
pipeline (KI-31). Shader group handle and stack size queries are decoded
through the host global state, and VK_KHR_pipeline_library is listed
together with VK_KHR_ray_tracing_pipeline.

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I560a0d2d6f21a5b9c920245115c5a668f1c5956e
---
 .../codegen/scripts/cereal/decoder.py         |  2 ++
 .../codegen/scripts/cereal/marshaling.py      |  6 +++++
 .../guest/vulkan_enc/ResourceTracker.cpp      |  4 ++++
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 24 +++++++++++++++++++
 4 files changed, 36 insertions(+)

diff --git a/src/gfxstream/codegen/scripts/cereal/decoder.py b/src/gfxstream/codegen/scripts/cereal/decoder.py
index 54eee60..275ef82 100644
--- a/src/gfxstream/codegen/scripts/cereal/decoder.py
+++ b/src/gfxstream/codegen/scripts/cereal/decoder.py
@@ -676,6 +676,8 @@ custom_decodes = {
     "vkGetAccelerationStructureBuildSizesKHR" : emit_global_state_wrapped_decoding,
     "vkCreateRayTracingPipelinesKHR" : emit_global_state_wrapped_decoding,
     "vkGetRayTracingCaptureReplayShaderGroupHandlesKHR" : emit_global_state_wrapped_decoding,
+    "vkGetRayTracingShaderGroupHandlesKHR" : emit_global_state_wrapped_decoding,
+    "vkGetRayTracingShaderGroupStackSizeKHR" : emit_global_state_wrapped_decoding,
     "vkBuildAccelerationStructuresKHR" : emit_global_state_wrapped_decoding,
     "vkCopyAccelerationStructureKHR" : emit_global_state_wrapped_decoding,
     "vkCopyAccelerationStructureToMemoryKHR" : emit_global_state_wrapped_decoding,
diff --git a/src/gfxstream/codegen/scripts/cereal/marshaling.py b/src/gfxstream/codegen/scripts/cereal/marshaling.py
index 9d1b29b..6afb52b 100644
--- a/src/gfxstream/codegen/scripts/cereal/marshaling.py
+++ b/src/gfxstream/codegen/scripts/cereal/marshaling.py
@@ -160,6 +160,12 @@ class VulkanMarshalingCodegen(VulkanTypeIterator):
                     self.cgen.stmt("sResourceTracker->register_%s(*%s)" % (vulkanType.typeName, access))
                 else:
                     self.cgen.beginFor("uint32_t k = 0", "k < %s" % lenAccess, "++k")
+                    # Elements the host did not create (for example in a multi-pipeline call that
+                    # returned an error) must stay VK_NULL_HANDLE for the application.
+                    self.cgen.beginIf("!%s[k]" % handle64Var)
+                    self.cgen.stmt("%s[k] = VK_NULL_HANDLE" % access)
+                    self.cgen.stmt("continue")
+                    self.cgen.endIf()
                     self.cgen.stmt("%s[k] = create_%s(%s[k])" % (access, gfxstreamType, handle64Var))
                     self.cgen.stmt("sResourceTracker->register_%s(%s[k])" % (vulkanType.typeName, access))
                     self.cgen.endFor()
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 6cf70eb..9ecd79c 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -2055,6 +2055,10 @@ VkResult ResourceTracker::on_vkEnumerateDeviceExtensionProperties(
                 rayTracingPipeline[0] == '1') {
                 int pipeline = getHostDeviceExtensionIndex(VK_KHR_RAY_TRACING_PIPELINE_EXTENSION_NAME);
                 if (pipeline != -1) filteredExts.push_back(mHostDeviceExtensions[pipeline]);
+                // CTS expects pipeline libraries with ray tracing pipelines; library handles are
+                // translated like any pipeline handle.
+                int library = getHostDeviceExtensionIndex(VK_KHR_PIPELINE_LIBRARY_EXTENSION_NAME);
+                if (pipeline != -1 && library != -1) filteredExts.push_back(mHostDeviceExtensions[library]);
             }
         }
     }
