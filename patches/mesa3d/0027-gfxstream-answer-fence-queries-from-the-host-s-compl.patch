+// Velox: true when the host's fence table (host gfxstream velox_fence_shared.h) holds a native
+// completion of |fence| for reset epoch |epoch|. The table is written only by the host; a torn
+// or foreign entry reads as "not known" and the caller asks the host.
+bool ResourceTracker::veloxFenceCompleted(VkFence fence, uint32_t epoch) {
+    struct Header {
+        uint32_t magic, version, slots, reserved[13];
+    };
+    struct Slot {
+        uint32_t seq, epoch;
+        uint64_t handle;
+    };
+    // The stream of a thread does not change while the thread lives, so the table pointer is
+    // looked up once per thread (the connection lookup is not free on every query).
+    static thread_local bool looked = false;
+    static thread_local const void* cachedTable = nullptr;
+    if (!looked) {
+        looked = true;
+        if (threadingCallbacks.veloxFenceTableGetFunc && threadingCallbacks.hostConnectionGetFunc) {
+            cachedTable =
+                threadingCallbacks.veloxFenceTableGetFunc(threadingCallbacks.hostConnectionGetFunc());
+        }
+    }
+    if (!cachedTable) return false;
+    const auto* header = static_cast<const Header*>(cachedTable);
+    if (__atomic_load_n(&header->magic, __ATOMIC_ACQUIRE) != 0x54465856u ||
+        __atomic_load_n(&header->version, __ATOMIC_RELAXED) != 1u ||
+        __atomic_load_n(&header->slots, __ATOMIC_RELAXED) != 64u) {
+        return false;
+    }
+    const uint64_t handle = gfxstream_vk_fence_to_host_u64(fence);
+    const uint32_t index =
+        static_cast<uint32_t>((handle * 0x9E3779B97F4A7C15ull) >> 58) & 63u;
+    const auto* slot = reinterpret_cast<const Slot*>(header + 1) + index;
+    const uint32_t s1 = __atomic_load_n(&slot->seq, __ATOMIC_ACQUIRE);
+    if (s1 & 1u) return false;
+    const uint64_t h = __atomic_load_n(&slot->handle, __ATOMIC_RELAXED);
+    const uint32_t e = __atomic_load_n(&slot->epoch, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    const uint32_t s2 = __atomic_load_n(&slot->seq, __ATOMIC_RELAXED);
+    const bool completed = s1 == s2 && h == handle && handle != 0 && e == epoch;
+    (completed ? mVeloxFenceHits : mVeloxFenceMisses).fetch_add(1, std::memory_order_relaxed);
+    return completed;
+}
