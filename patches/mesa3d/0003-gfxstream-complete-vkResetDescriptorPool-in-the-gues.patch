diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index ee8609a..570bf76 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -18,6 +18,10 @@
 #include "util/detect_os.h"
 #include "util/log.h"
 #include "util/macros.h"
+#include "util/u_debug.h"
+#if DETECT_OS_ANDROID
+#include <sys/system_properties.h>
+#endif
 #include "virtio/virtio-gpu/virgl_hw.h"
 #include "vulkan/util/vk_format.h"
 #include "vulkan/vulkan_core.h"
@@ -854,7 +858,8 @@ static void collectAllPendingDescriptorSetsBottomUp(const std::vector<VkCommandB
 }
 
 static void commitDescriptorSetUpdates(void* context, VkQueue queue,
-                                       const std::unordered_set<VkDescriptorSet>& sets) {
+                                       const std::unordered_set<VkDescriptorSet>& sets,
+                                       bool withResetEpochs) {
     VkEncoder* enc = (VkEncoder*)context;
 
     std::unordered_map<VkDescriptorPool, uint32_t> poolSet;
@@ -959,11 +964,26 @@ static void commitDescriptorSetUpdates(void* context, VkQueue queue,
         return;
     }
 
-    enc->vkQueueCommitDescriptorSetUpdatesGOOGLE(
-        queue, (uint32_t)pools.size(), pools.data(), (uint32_t)sets.size(), setLayouts.data(),
-        poolIds.data(), descriptorSetWhichPool.data(), pendingAllocations.data(),
-        writeStartingIndices.data(), (uint32_t)writesForHost.size(), writesForHost.data(),
-        false /* no lock */);
+    if (withResetEpochs) {
+        // Every commit of a pool carries the pool's current reset epoch, so the host applies a
+        // deferred reset before the first allocation made after it, whichever stream commits it.
+        std::vector<uint64_t> resetEpochs(pools.size());
+        for (size_t i = 0; i < pools.size(); ++i) {
+            resetEpochs[i] = gfxstream_vk_descriptor_pool_from_handle(pools[i])
+                                 ->allocInfo->resetEpoch.load(std::memory_order_acquire);
+        }
+        enc->vkQueueCommitDescriptorSetUpdates2GOOGLE(
+            queue, (uint32_t)pools.size(), pools.data(), resetEpochs.data(), (uint32_t)sets.size(),
+            setLayouts.data(), poolIds.data(), descriptorSetWhichPool.data(),
+            pendingAllocations.data(), writeStartingIndices.data(),
+            (uint32_t)writesForHost.size(), writesForHost.data(), false /* no lock */);
+    } else {
+        enc->vkQueueCommitDescriptorSetUpdatesGOOGLE(
+            queue, (uint32_t)pools.size(), pools.data(), (uint32_t)sets.size(), setLayouts.data(),
+            poolIds.data(), descriptorSetWhichPool.data(), pendingAllocations.data(),
+            writeStartingIndices.data(), (uint32_t)writesForHost.size(), writesForHost.data(),
+            false /* no lock */);
+    }
 
     // If we got here, then we definitely serviced the allocations.
     for (auto set : sets) {
@@ -1469,6 +1489,18 @@ void ResourceTracker::setupCaps(uint32_t& noRenderControlEnc) {
     noRenderControlEnc = mCaps.vulkanCapset.noRenderControlEnc;
 }
 
+// For A/B measurements: debug.velox.defer_pool_reset=0 (Android) or
+// GFXSTREAM_DEFERRED_DESCRIPTOR_POOL_RESET=false turns the deferred descriptor pool reset off.
+static bool deferredDescriptorPoolResetAllowed() {
+#if DETECT_OS_ANDROID
+    char value[PROP_VALUE_MAX] = {};
+    if (__system_property_get("debug.velox.defer_pool_reset", value) > 0) {
+        return strcmp(value, "0") != 0 && strcmp(value, "false") != 0;
+    }
+#endif
+    return debug_get_bool_option("GFXSTREAM_DEFERRED_DESCRIPTOR_POOL_RESET", true);
+}
+
 void ResourceTracker::setupFeatures(const struct GfxStreamVkFeatureInfo* features) {
     if (mFeatureInfo.setupComplete) {
         return;
@@ -1525,6 +1557,14 @@ void ResourceTracker::setupFeatures(const struct GfxStreamVkFeatureInfo* feature
         ResourceTracker::streamFeatureBits |= VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     }
 
+    // Deferring the host reset relies on the host executing all commands of this process in
+    // encoding order (queue submit with commands) and on the guest-side pool accounting of the
+    // batched descriptor update mode.
+    mDeferredDescriptorPoolReset =
+        mFeatureInfo.hasVulkanBatchedDescriptorSetUpdate &&
+        mFeatureInfo.hasVulkanQueueSubmitWithCommands &&
+        mFeatureInfo.hasVulkanDeferredDescriptorPoolReset && deferredDescriptorPoolResetAllowed();
+
     mFeatureInfo.setupComplete = true;
 }
 
@@ -5338,6 +5378,22 @@ VkResult ResourceTracker::on_vkResetDescriptorPool(void* context, VkResult, VkDe
 
     VkEncoder* enc = (VkEncoder*)context;
 
+    if (mDeferredDescriptorPoolReset) {
+        // With batched descriptor updates the guest owns the pool accounting: sets are allocated
+        // and written locally and only reach the host when a queue submit commits them. The
+        // reset therefore completes here; the host resets its pool when the next commit of this
+        // pool carries the new epoch (vkQueueCommitDescriptorSetUpdates2GOOGLE), which is always
+        // before the host allocates any set made after this reset.
+        //
+        // vkResetDescriptorPool has no error result besides the generic VK_ERROR_UNKNOWN, and the
+        // application must not reset a pool while its sets are in use
+        // (VUID-vkResetDescriptorPool-descriptorPool-00313), so no host result is needed here.
+        clearDescriptorPoolAndUnregisterDescriptorSets(context, device, descriptorPool);
+        gfxstream_vk_descriptor_pool_from_handle(descriptorPool)
+            ->allocInfo->resetEpoch.fetch_add(1, std::memory_order_release);
+        return VK_SUCCESS;
+    }
+
     VkResult res = enc->vkResetDescriptorPool(device, descriptorPool, flags, true /* do lock */);
 
     if (res != VK_SUCCESS) return res;
@@ -6371,7 +6427,7 @@ void ResourceTracker::flushStagingStreams(void* context, VkQueue queue, uint32_t
 
     std::unordered_set<VkDescriptorSet> pendingSets;
     collectAllPendingDescriptorSetsBottomUp(toFlush, pendingSets);
-    commitDescriptorSetUpdates(context, queue, pendingSets);
+    commitDescriptorSetUpdates(context, queue, pendingSets, mDeferredDescriptorPoolReset);
 
     flushCommandBufferPendingCommandsBottomUp(context, queue, toFlush);
 
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
index 2b795e7..ef915ed 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
@@ -109,6 +109,7 @@ struct GfxStreamVkFeatureInfo {
