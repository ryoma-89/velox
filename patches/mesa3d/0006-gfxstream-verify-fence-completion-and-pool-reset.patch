From e3bc2d3108de9ca5b9073ac4fd714522383eee0c Mon Sep 17 00:00:00 2001
From: Velox <velox@localhost>
Date: Sat, 21 Nov 2026 22:38:24 +0900
Subject: [PATCH] gfxstream: cache confirmed fences and only reset unbacked
 pools locally

Change-Id: I82ad5efbcb55571e56d9ce62da17ce426b1c7e5a
---
 .../codegen/scripts/cereal/functable.py       |  10 -
 .../DescriptorSetVirtualization.cpp           |  39 +-
 .../vulkan_enc/DescriptorSetVirtualization.h  |   7 +-
 .../guest/vulkan_enc/ResourceTracker.cpp      | 509 +++++-------------
 .../guest/vulkan_enc/ResourceTracker.h        |  60 +--
 .../vulkan_enc/autogenerated/func_table.cpp   |  20 +-
 6 files changed, 155 insertions(+), 490 deletions(-)

diff --git a/src/gfxstream/codegen/scripts/cereal/functable.py b/src/gfxstream/codegen/scripts/cereal/functable.py
index 7988f04..056e54f 100644
--- a/src/gfxstream/codegen/scripts/cereal/functable.py
+++ b/src/gfxstream/codegen/scripts/cereal/functable.py
@@ -35,16 +35,6 @@ RESOURCE_TRACKER_ENTRIES = [
     "vkQueueSubmit",
     "vkQueueSubmit2",
     "vkQueueWaitIdle",
-    # Velox: calls that tell the guest that queue work completed. Fence status hints
-    # (ResourceTracker::on_vkGetFenceStatus) must not report a fence as unsignaled after the
-    # guest observed completion of later work on the host.
-    "vkDeviceWaitIdle",
-    "vkWaitSemaphores",
-    "vkWaitSemaphoresKHR",
-    "vkGetSemaphoreCounterValue",
-    "vkGetSemaphoreCounterValueKHR",
-    "vkGetQueryPoolResults",
-    "vkGetEventStatus",
     "vkImportSemaphoreFdKHR",
     "vkGetSemaphoreFdKHR",
     # Warning: These need to be defined in vk.xml (currently no-op) {
diff --git a/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.cpp b/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.cpp
index 154924a..910b7e2 100644
--- a/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.cpp
+++ b/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.cpp
@@ -469,7 +469,6 @@ void fillDescriptorSetInfoForPool(VkDescriptorPool pool, VkDescriptorSetLayout s
 
     gfxstream_vk_descriptor_set_from_handle(set)->reified = newReified;
 
-    allocInfo->allocedPoolIds.insert(newReified->poolId);
     allocInfo->allocedSets.insert(set);
 
     initializeReifiedDescriptorSet(pool, setLayout, newReified);
@@ -481,23 +480,16 @@ VkResult validateAndApplyVirtualDescriptorSetAllocation(
 
     if (validateRes != VK_SUCCESS) return validateRes;
 
-    for (uint32_t i = 0; i < pAllocateInfo->descriptorSetCount; ++i) {
-        applyDescriptorSetAllocation(pAllocateInfo->descriptorPool, pAllocateInfo->pSetLayouts[i]);
-    }
-
     VkDescriptorPool pool = pAllocateInfo->descriptorPool;
     DescriptorPoolAllocationInfo* allocInfo =
         gfxstream_vk_descriptor_pool_from_handle(pool)->allocInfo;
 
     if (allocInfo->freePoolIds.size() < pAllocateInfo->descriptorSetCount) {
-        mesa_loge(
-            "%s: FATAL: Somehow out of descriptor pool IDs. Wanted %u IDs but only have %u free "
-            "IDs remaining. The count for maxSets was %u and used was %u\n",
-            __func__, pAllocateInfo->descriptorSetCount, (uint32_t)allocInfo->freePoolIds.size(),
-            allocInfo->maxSets, allocInfo->usedSets);
+        return VK_ERROR_OUT_OF_POOL_MEMORY;
     }
 
     for (uint32_t i = 0; i < pAllocateInfo->descriptorSetCount; ++i) {
+        applyDescriptorSetAllocation(pool, pAllocateInfo->pSetLayouts[i]);
         uint64_t id = allocInfo->freePoolIds.back();
         allocInfo->freePoolIds.pop_back();
 
@@ -517,36 +509,31 @@ bool removeDescriptorSetFromPool(VkDescriptorSet set, bool usePoolIds) {
     DescriptorPoolAllocationInfo* allocInfo =
         gfxstream_vk_descriptor_pool_from_handle(pool)->allocInfo;
 
-    if (usePoolIds) {
-        // Look for the set's pool Id in the pool. If not found, then this wasn't really allocated,
-        // and bail.
-        if (allocInfo->allocedPoolIds.find(reified->poolId) == allocInfo->allocedPoolIds.end()) {
-            return false;
-        }
-    }
+    if (allocInfo->allocedSets.erase(set) == 0) return false;
 
     const std::vector<VkDescriptorSetLayoutBinding>& bindings = reified->bindings;
     removeDescriptorSetAllocation(pool, bindings);
 
     if (usePoolIds) {
         allocInfo->freePoolIds.push_back(reified->poolId);
-        allocInfo->allocedPoolIds.erase(reified->poolId);
     }
-    allocInfo->allocedSets.erase(set);
 
     return true;
 }
 
 std::vector<VkDescriptorSet> clearDescriptorPool(VkDescriptorPool pool, bool usePoolIds) {
-    std::vector<VkDescriptorSet> toClear;
-    for (auto set : gfxstream_vk_descriptor_pool_from_handle(pool)->allocInfo->allocedSets) {
-        toClear.push_back(set);
+    auto& info = *gfxstream_vk_descriptor_pool_from_handle(pool)->allocInfo;
+    std::vector<VkDescriptorSet> toClear(info.allocedSets.begin(), info.allocedSets.end());
+    if (usePoolIds) {
+        for (VkDescriptorSet set : toClear) {
+            info.freePoolIds.push_back(gfxstream_vk_descriptor_set_from_handle(set)->reified->poolId);
+        }
     }
-
-    for (auto set : toClear) {
-        removeDescriptorSetFromPool(set, usePoolIds);
+    info.allocedSets.clear();
+    info.usedSets = 0;
+    for (auto& count : info.descriptorCountInfo) {
+        count.used = 0;
     }
-
     return toClear;
 }
 
diff --git a/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.h b/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.h
index d3e9a9a..6d101c2 100644
--- a/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.h
+++ b/src/gfxstream/guest/vulkan_enc/DescriptorSetVirtualization.h
@@ -73,15 +73,12 @@ struct DescriptorPoolAllocationInfo {
 
     // TODO: This should be in a single fancy data structure of some kind.
     std::vector<uint64_t> freePoolIds;
-    std::unordered_set<uint32_t> allocedPoolIds;
     std::unordered_set<VkDescriptorSet> allocedSets;
     uint32_t maxSets;
     uint32_t usedSets;
 
-    // Number of guest-side resets (deferred descriptor pool reset). Written by
-    // vkResetDescriptorPool (the pool is externally synchronized) and read when a queue submit
-    // commits descriptor sets of this pool, possibly on another thread.
-    std::atomic<uint64_t> resetEpoch{0};
+    // Set before encoding the first host allocation after creation or a successful reset.
+    std::atomic<bool> hasHostAllocations{false};
 
     // Fine-grained tracking of descriptor counts in individual pools
     struct DescriptorCountInfo {
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
