-        (unsigned long long)mStatFenceStatusLocalNotReady.load(),
-        (unsigned long long)mStatHintsArmed.load(),
         (unsigned long long)mStatWaitForFencesCalls.load(),
         (unsigned long long)mStatWaitForFencesRpc.load(),
-        (unsigned long long)mStatPoolResets.load());
-}
-
-void ResourceTracker::clearFenceStatusHintLocked(VkFence_Info& info) {
-#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
-    if (info.hintFd >= 0) mSyncHelper->close(info.hintFd);
-#endif
-    info.hintFd = -1;
-    info.signaledConfirmed = false;
-    ++info.hintGeneration;
-}
-
-// After a submission with |fence|, ask the host to signal a goldfish sync fd once its wait on the
-// VkFence returns. The host signals unconditionally, also on timeout (5 s) or error, and sync
-// points of one timeline signal in order, so the fd only tells that the fence may be signaled;
-// on_vkGetFenceStatus confirms with the host before reporting VK_SUCCESS.
-void ResourceTracker::armFenceStatusHint(VkFence fence, uint64_t seq) {
-#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
-    if (!mFenceStatusHints || fence == VK_NULL_HANDLE) return;
-    ensureSyncDeviceFd();
-    std::lock_guard<std::recursive_mutex> lock(mLock);
-    if (mSyncDeviceFd < 0) {
-        mFenceStatusHints = false;
-        return;
-    }
-    auto it = info_VkFence.find(fence);
-    if (it == info_VkFence.end()) return;
-    auto& info = it->second;
-    if (info.external) return;
-    clearFenceStatusHintLocked(info);
-    // Type byte 0x56 (GOLDFISH_SYNC_VULKAN_FENCE_HINT on the host) and the fence's submission
-    // number above it: the host signals once that submission completed, was reset or superseded.
-    constexpr uint64_t kGoldfishSyncVulkanFenceHint = 0x56;
-    int fd = -1;
-    if (goldfish_sync_queue_work(mSyncDeviceFd, gfxstream_vk_fence_to_host_u64(fence),
-                                 (info.submitCount << 8) | kGoldfishSyncVulkanFenceHint,
-                                 &fd) != 0 ||
-        fd < 0) {
-        return;
-    }
-    info.hintFd = fd;
-    info.hintSeq = seq;
-    mStatHintsArmed.fetch_add(1, std::memory_order_relaxed);
-#else
-    (void)fence;
-    (void)seq;
-#endif
+        (unsigned long long)mStatResetFencesRpc.load(),
+        (unsigned long long)mStatPoolResets.load(),
+        (unsigned long long)mStatPoolResetRpc.load());
 }
 
 void ResourceTracker::unregister_VkFence(VkFence fence) {
@@ -1311,7 +1257,6 @@ void ResourceTracker::unregister_VkFence(VkFence fence) {
         mSyncHelper->close(*fenceInfo.syncFd);
     }
 #endif
-    clearFenceStatusHintLocked(fenceInfo);
 
     info_VkFence.erase(fence);
