         writeStartingIndices.push_back(currentWriteIndex);
 
         auto& writes = reified->allWrites;
@@ -959,32 +961,22 @@ static void commitDescriptorSetUpdates(void* context, VkQueue queue,
         }
     }
 
-    // Skip out if there's nothing to VkWriteDescriptorSet home about.
-    if (writesForHost.empty()) {
-        return;
-    }
+    if (writesForHost.empty() && !needsAllocation) return;
 
-    if (withResetEpochs) {
-        // Every commit of a pool carries the pool's current reset epoch, so the host applies a
-        // deferred reset before the first allocation made after it, whichever stream commits it.
-        std::vector<uint64_t> resetEpochs(pools.size());
-        for (size_t i = 0; i < pools.size(); ++i) {
-            resetEpochs[i] = gfxstream_vk_descriptor_pool_from_handle(pools[i])
-                                 ->allocInfo->resetEpoch.load(std::memory_order_acquire);
+    if (trackHostAllocations) {
+        // A pool can be reset in the guest only if it has no backing sets to reset.
+        for (VkDescriptorPool pool : pools) {
+            gfxstream_vk_descriptor_pool_from_handle(pool)
+                ->allocInfo->hasHostAllocations.store(true, std::memory_order_release);
         }
-        enc->vkQueueCommitDescriptorSetUpdates2GOOGLE(
-            queue, (uint32_t)pools.size(), pools.data(), resetEpochs.data(), (uint32_t)sets.size(),
-            setLayouts.data(), poolIds.data(), descriptorSetWhichPool.data(),
-            pendingAllocations.data(), writeStartingIndices.data(),
-            (uint32_t)writesForHost.size(), writesForHost.data(), false /* no lock */);
-    } else {
-        enc->vkQueueCommitDescriptorSetUpdatesGOOGLE(
-            queue, (uint32_t)pools.size(), pools.data(), (uint32_t)sets.size(), setLayouts.data(),
-            poolIds.data(), descriptorSetWhichPool.data(), pendingAllocations.data(),
-            writeStartingIndices.data(), (uint32_t)writesForHost.size(), writesForHost.data(),
-            false /* no lock */);
     }
 
+    enc->vkQueueCommitDescriptorSetUpdatesGOOGLE(
+        queue, (uint32_t)pools.size(), pools.data(), (uint32_t)sets.size(), setLayouts.data(),
+        poolIds.data(), descriptorSetWhichPool.data(), pendingAllocations.data(),
+        writeStartingIndices.data(), (uint32_t)writesForHost.size(), writesForHost.data(),
+        false /* no lock */);
+
     // If we got here, then we definitely serviced the allocations.
     for (auto set : sets) {
         ReifiedDescriptorSet* reified = gfxstream_vk_descriptor_set_from_handle(set)->reified;
@@ -1240,62 +1232,16 @@ void ResourceTracker::maybeLogFenceStats() {
     if (now - last < 10000000000ull) return;
     if (!mStatStatsLastNs.compare_exchange_strong(last, now)) return;
     mesa_logi(
-        "velox-fence-stats: submitsWithFence=%llu getFenceStatus=%llu rpc=%llu localReady=%llu "
