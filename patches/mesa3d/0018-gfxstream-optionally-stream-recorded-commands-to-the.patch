+++ b/src/gfxstream/guest/iostream/include/gfxstream/guest/IOStream.h
@@ -82,6 +82,9 @@ class IOStream {
         return stat;
     }
 
+    // Bytes handed out by alloc() but not yet passed to commitBuffer() (committed by flush()).
