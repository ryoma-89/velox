+    Allocation expandUnpublishedBuffer(const Allocation& alloc, uint64_t size) {
+        AutoLock lock(mLock);
+        if (alloc.blockIndex >= mBufferBlocks.size()) return {};
+        auto& block = mBufferBlocks[alloc.blockIndex];
+        if (block.isEmpty) return {};
+
+        // Stay inside the same backing block. Graphics pings can run without
+        // the BQL, and this path must not add or remove a GPA mapping.
+        auto* buffer = static_cast<char*>(block.subAlloc->alloc(size));
+        if (!buffer) return {};
+        if (!block.subAlloc->free(alloc.buffer)) {
+            block.subAlloc->free(buffer);
+            return {};
+        }
+        Allocation expanded = alloc;
+        expanded.buffer = buffer;
+        expanded.size = size;
+        expanded.offsetIntoPhys = block.offsetIntoPhys + block.subAlloc->getOffset(buffer);
+        return expanded;
     }
 
