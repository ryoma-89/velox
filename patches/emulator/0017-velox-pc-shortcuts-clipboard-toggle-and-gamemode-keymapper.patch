+int EmulatorQtWindow::parseVeloxQtKey(const QString& raw) {
+    const QString k = raw.trimmed().toUpper();
+    if (k.size() == 1) {
+        const QChar c = k[0];
+        if (c >= 'A' && c <= 'Z') return Qt::Key_A + (c.unicode() - 'A');
+        if (c >= '0' && c <= '9') return Qt::Key_0 + (c.unicode() - '0');
+    }
+    if (k == "SPACE") return Qt::Key_Space;
+    if (k == "TAB") return Qt::Key_Tab;
+    if (k == "SHIFT") return Qt::Key_Shift;
+    if (k == "CTRL" || k == "CONTROL") return Qt::Key_Control;
+    if (k == "ALT") return Qt::Key_Alt;
+    if (k == "ESC" || k == "ESCAPE") return Qt::Key_Escape;
+    if (k == "ENTER" || k == "RETURN") return Qt::Key_Return;
+    if (k == "PAUSE") return Qt::Key_Pause;
+    if (k == "SCROLLLOCK") return Qt::Key_ScrollLock;
+    if (k == "HOME") return Qt::Key_Home;
+    if (k == "END") return Qt::Key_End;
+    if (k == "PAGEUP") return Qt::Key_PageUp;
+    if (k == "PAGEDOWN") return Qt::Key_PageDown;
+    if (k.startsWith('F') && k.size() <= 3) {
+        bool ok = false;
+        int n = k.mid(1).toInt(&ok);
+        if (ok && n >= 1 && n <= 12) return Qt::Key_F1 + (n - 1);
+    }
+    return 0;
+}
+
+void EmulatorQtWindow::initVeloxDesktopFeatures() {
+    if (const char* hk = std::getenv("VELOX_HOME_KEY")) {
+        QString spec = QString::fromUtf8(hk).trimmed();
+        if (!spec.isEmpty()) {
+            Qt::KeyboardModifiers mods = Qt::NoModifier;
+            QStringList parts = spec.split('+', Qt::SkipEmptyParts);
+            for (int i = 0; i + 1 < parts.size(); ++i) {
+                QString m = parts[i].trimmed().toUpper();
+                if (m == "ALT") mods |= Qt::AltModifier;
+                else if (m == "CTRL" || m == "CONTROL") mods |= Qt::ControlModifier;
+                else if (m == "SHIFT") mods |= Qt::ShiftModifier;
+            }
+            if (!parts.isEmpty()) {
+                mVeloxHomeQtKey = parseVeloxQtKey(parts.last());
+                mVeloxHomeQtMods = mods;
+            }
+        }
+    }
+    if (const char* km = std::getenv("VELOX_KEYMAP_FILE")) {
+        mVeloxKeymapPath = QString::fromUtf8(km).trimmed();
+        maybeReloadVeloxKeymap(true);
+    }
+}
+
+void EmulatorQtWindow::maybeReloadVeloxKeymap(bool force) {
+    if (mVeloxKeymapPath.isEmpty()) {
+        return;
+    }
+    if (!force && mVeloxKeymapPollTimer.isValid() &&
+        mVeloxKeymapPollTimer.elapsed() < 500) {
+        return;
+    }
+    mVeloxKeymapPollTimer.restart();
+    QFileInfo fi(mVeloxKeymapPath);
+    if (!fi.exists()) {
+        if (mVeloxKeymapEnabled) {
+            releaseVeloxGameInputs();
+            mVeloxKeymapEnabled = false;
+        }
+        return;
+    }
+    qint64 mtime = fi.lastModified().toMSecsSinceEpoch();
+    if (!force && mtime == mVeloxKeymapMtimeMs) {
+        return;
+    }
+    mVeloxKeymapMtimeMs = mtime;
+
+    QFile f(mVeloxKeymapPath);
+    if (!f.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    QJsonParseError err;
+    QJsonDocument doc = QJsonDocument::fromJson(f.readAll(), &err);
+    if (err.error != QJsonParseError::NoError || !doc.isObject()) {
+        return;
+    }
+    releaseVeloxGameInputs();
+    QJsonObject obj = doc.object();
+    mVeloxKeymapEnabled = obj.value("enabled").toBool(false);
+    int capKey = parseVeloxQtKey(obj.value("toggle_capture_key").toString("F8"));
+    mVeloxCaptureToggleKey = capKey ? capKey : Qt::Key_F8;
+
+    QJsonObject joy = obj.value("joystick").toObject();
+    mVeloxJoyEnabled = joy.value("enabled").toBool(false);
+    mVeloxJoyUp = parseVeloxQtKey(joy.value("up").toString("W"));
+    mVeloxJoyDown = parseVeloxQtKey(joy.value("down").toString("S"));
+    mVeloxJoyLeft = parseVeloxQtKey(joy.value("left").toString("A"));
+    mVeloxJoyRight = parseVeloxQtKey(joy.value("right").toString("D"));
+    mVeloxJoyCx = std::clamp(joy.value("cx").toDouble(0.18), 0.02, 0.98);
+    mVeloxJoyCy = std::clamp(joy.value("cy").toDouble(0.76), 0.02, 0.98);
+    mVeloxJoyRadius = std::clamp(joy.value("radius").toDouble(0.10), 0.02, 0.35);
+
+    mVeloxTapBinds.clear();
+    QJsonArray keys = obj.value("keys").toArray();
+    int nextId = 91;
+    for (const QJsonValue& val : keys) {
+        if (!val.isObject() || nextId >= 98) continue;
+        QJsonObject ko = val.toObject();
+        int qk = parseVeloxQtKey(ko.value("key").toString());
+        if (!qk) continue;
+        VeloxTapBind b;
+        b.qtKey = qk;
+        b.rx = std::clamp(ko.value("x").toDouble(0.5), 0.01, 0.99);
+        b.ry = std::clamp(ko.value("y").toDouble(0.5), 0.01, 0.99);
+        b.touchId = nextId++;
+        mVeloxTapBinds.push_back(b);
+    }
+
+    QJsonObject ml = obj.value("mouse_look").toObject();
+    mVeloxMouseLookEnabled = ml.value("enabled").toBool(false);
+    mVeloxMouseLookCx = std::clamp(ml.value("cx").toDouble(0.72), 0.10, 0.90);
+    mVeloxMouseLookCy = std::clamp(ml.value("cy").toDouble(0.50), 0.10, 0.90);
+    mVeloxMouseLookSens = std::clamp(ml.value("sensitivity").toDouble(1.0), 0.1, 4.0);
+}
+
+void EmulatorQtWindow::sendVeloxVirtualTouch(SkinEventType type,
+                                             int touchId,
+                                             int x,
+                                             int y) {
+    SkinEvent ev = createSkinEvent(type);
+    ev.u.multi_touch_point.x = x;
+    ev.u.multi_touch_point.y = y;
+    QPoint g = mapToGlobal(QPoint(x, y));
+    ev.u.multi_touch_point.x_global = g.x();
+    ev.u.multi_touch_point.y_global = g.y();
+    ev.u.multi_touch_point.id = touchId;
+    ev.u.multi_touch_point.pressure = (type == kEventTouchEnd) ? 0 : (MTS_PRESSURE_RANGE_MAX / 2);
+    ev.u.multi_touch_point.touch_major = 8;
+    ev.u.multi_touch_point.touch_minor = 8;
+    ev.u.multi_touch_point.orientation = 0;
+    ev.u.multi_touch_point.skip_sync = false;
+    ev.u.multi_touch_point.display_id = 0;
+    queueSkinEvent(std::move(ev));
+}
+
+void EmulatorQtWindow::updateVeloxJoystickTouch() {
+    double dx = (mVeloxJoyHeld[3] ? 1.0 : 0.0) - (mVeloxJoyHeld[2] ? 1.0 : 0.0);
+    double dy = (mVeloxJoyHeld[1] ? 1.0 : 0.0) - (mVeloxJoyHeld[0] ? 1.0 : 0.0);
+    const int w = std::max(1, width());
+    const int h = std::max(1, height());
+    const double cx = mVeloxJoyCx * w;
+    const double cy = mVeloxJoyCy * h;
+    if (dx == 0.0 && dy == 0.0) {
+        if (mVeloxJoyTouchActive) {
+            sendVeloxVirtualTouch(kEventTouchEnd, 90, (int)cx, (int)cy);
+            mVeloxJoyTouchActive = false;
+        }
+        return;
+    }
+    const double len = std::hypot(dx, dy);
+    const double r = mVeloxJoyRadius * std::min(w, h);
+    const int tx = std::clamp((int)(cx + (dx / len) * r), 0, w - 1);
+    const int ty = std::clamp((int)(cy + (dy / len) * r), 0, h - 1);
+    if (!mVeloxJoyTouchActive) {
+        sendVeloxVirtualTouch(kEventTouchBegin, 90, (int)cx, (int)cy);
+        mVeloxJoyTouchActive = true;
+    }
+    sendVeloxVirtualTouch(kEventTouchUpdate, 90, tx, ty);
+}
+
+void EmulatorQtWindow::setVeloxMouseLookCaptured(bool capture) {
+    if (capture == mVeloxMouseLookCaptured) {
+        return;
+    }
+    mVeloxMouseLookCaptured = capture;
+    if (capture) {
+        setMouseTracking(true);
+        setCursor(Qt::BlankCursor);
+        QPoint center(width() / 2, height() / 2);
+        mVeloxMouseLookRecentering = true;
+        QCursor::setPos(mapToGlobal(center));
+        mVeloxMouseLookLastLocal = center;
+        mVeloxMouseLookCurX = mVeloxMouseLookCx * std::max(1, width());
+        mVeloxMouseLookCurY = mVeloxMouseLookCy * std::max(1, height());
+        sendVeloxVirtualTouch(kEventTouchBegin, 99, (int)mVeloxMouseLookCurX,
+                              (int)mVeloxMouseLookCurY);
+        mVeloxMouseLookTouchActive = true;
+    } else {
+        if (mVeloxMouseLookTouchActive) {
+            sendVeloxVirtualTouch(kEventTouchEnd, 99, (int)mVeloxMouseLookCurX,
+                                  (int)mVeloxMouseLookCurY);
+            mVeloxMouseLookTouchActive = false;
+        }
+        unsetCursor();
+        mVeloxMouseLookRecentering = false;
+    }
+}
+
+void EmulatorQtWindow::releaseVeloxGameInputs() {
+    if (mVeloxMouseLookCaptured) {
+        setVeloxMouseLookCaptured(false);
+    }
+    bool anyJoy = false;
+    for (bool& h : mVeloxJoyHeld) {
+        if (h) anyJoy = true;
+        h = false;
+    }
+    if (anyJoy || mVeloxJoyTouchActive) {
+        updateVeloxJoystickTouch();
+    }
+    const int w = std::max(1, width());
+    const int h = std::max(1, height());
+    for (auto& b : mVeloxTapBinds) {
+        if (b.active) {
+            sendVeloxVirtualTouch(kEventTouchEnd, b.touchId, (int)(b.rx * w),
+                                  (int)(b.ry * h));
+            b.active = false;
+        }
+    }
+}
+
+bool EmulatorQtWindow::handleVeloxDesktopShortcut(const QKeyEvent* event,
+                                                  bool pressed) {
+    if (!event) return false;
+    // F11 toggles fullscreen cleanly ONLY when this emulator window has focus.
+    if (event->key() == Qt::Key_F11 && event->modifiers() == Qt::NoModifier) {
+        if (pressed && !event->isAutoRepeat()) {
+            if (mContainer.isFullScreen()) {
+                mContainer.showNormal();
+            } else {
+                mContainer.showFullScreen();
+            }
+        }
+        return true;
+    }
+    // User-configurable Home key (VELOX_HOME_KEY, e.g. F12 or Alt+H)
+    if (mVeloxHomeQtKey != 0 && event->key() == mVeloxHomeQtKey &&
+        (event->modifiers() & (Qt::AltModifier | Qt::ControlModifier |
+                               Qt::ShiftModifier)) == mVeloxHomeQtMods) {
+        if (!event->isAutoRepeat()) {
+            SkinEvent sk = createSkinEvent(pressed ? kEventKeyDown : kEventKeyUp);
+            sk.u.key.keycode = LINUX_KEY_HOME;
+            sk.u.key.mod = 0;
+            queueSkinEvent(std::move(sk));
+        }
+        return true;
+    }
+    return false;
+}
+
+bool EmulatorQtWindow::handleVeloxKeymapKey(const QKeyEvent* event,
+                                            bool pressed) {
+    if (!event) return false;
+    maybeReloadVeloxKeymap(false);
+    if (!mVeloxKeymapEnabled) return false;
+    if (event->isAutoRepeat()) return true;
+
+    const int k = event->key();
+    // Toggle mouse-look capture cleanly (Esc always releases capture)
+    if (mVeloxMouseLookEnabled && k == mVeloxCaptureToggleKey) {
+        if (pressed) {
+            setVeloxMouseLookCaptured(!mVeloxMouseLookCaptured);
+        }
+        return true;
+    }
+    if (mVeloxMouseLookCaptured && k == Qt::Key_Escape) {
+        if (pressed) {
+            setVeloxMouseLookCaptured(false);
+        }
+        return true;
+    }
+
+    // 1:1 WASD virtual joystick mapping
+    if (mVeloxJoyEnabled) {
+        int dir = -1;
+        if (k == mVeloxJoyUp) dir = 0;
+        else if (k == mVeloxJoyDown) dir = 1;
+        else if (k == mVeloxJoyLeft) dir = 2;
+        else if (k == mVeloxJoyRight) dir = 3;
+        if (dir >= 0) {
+            mVeloxJoyHeld[dir] = pressed;
+            updateVeloxJoystickTouch();
+            return true;
+        }
+    }
+
+    // 1:1 custom key-to-touch bindings
+    const int w = std::max(1, width());
+    const int h = std::max(1, height());
+    for (auto& b : mVeloxTapBinds) {
+        if (b.qtKey == k) {
+            if (pressed && !b.active) {
+                b.active = true;
+                sendVeloxVirtualTouch(kEventTouchBegin, b.touchId,
+                                      (int)(b.rx * w), (int)(b.ry * h));
+            } else if (!pressed && b.active) {
+                b.active = false;
+                sendVeloxVirtualTouch(kEventTouchEnd, b.touchId,
+                                      (int)(b.rx * w), (int)(b.ry * h));
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+bool EmulatorQtWindow::handleVeloxMouseLookMove(QMouseEvent* event) {
+    if (!mVeloxMouseLookCaptured || !event) return false;
+    const QPoint pos = event->pos();
+    const QPoint center(width() / 2, height() / 2);
+    if (mVeloxMouseLookRecentering) {
+        if ((pos - center).manhattanLength() <= 6) {
+            mVeloxMouseLookRecentering = false;
+            mVeloxMouseLookLastLocal = pos;
+        }
+        return true;
+    }
+    const double dx = (pos.x() - mVeloxMouseLookLastLocal.x()) * mVeloxMouseLookSens;
+    const double dy = (pos.y() - mVeloxMouseLookLastLocal.y()) * mVeloxMouseLookSens;
+    mVeloxMouseLookLastLocal = pos;
+    if (dx == 0.0 && dy == 0.0) return true;
+
+    const int w = std::max(1, width());
+    const int h = std::max(1, height());
+    mVeloxMouseLookCurX += dx;
+    mVeloxMouseLookCurY += dy;
+    // Re-anchor smoothly if approaching viewport edge
+    if (mVeloxMouseLookCurX < w * 0.15 || mVeloxMouseLookCurX > w * 0.95 ||
+        mVeloxMouseLookCurY < h * 0.10 || mVeloxMouseLookCurY > h * 0.90) {
+        sendVeloxVirtualTouch(kEventTouchEnd, 99,
+                              std::clamp((int)mVeloxMouseLookCurX, 0, w - 1),
+                              std::clamp((int)mVeloxMouseLookCurY, 0, h - 1));
+        mVeloxMouseLookCurX = mVeloxMouseLookCx * w;
+        mVeloxMouseLookCurY = mVeloxMouseLookCy * h;
+        sendVeloxVirtualTouch(kEventTouchBegin, 99, (int)mVeloxMouseLookCurX,
+                              (int)mVeloxMouseLookCurY);
+    } else {
+        sendVeloxVirtualTouch(kEventTouchUpdate, 99,
+                              std::clamp((int)mVeloxMouseLookCurX, 0, w - 1),
+                              std::clamp((int)mVeloxMouseLookCurY, 0, h - 1));
+    }
+
+    // Keep host cursor centered inside the emulator window while captured
+    if (std::abs(pos.x() - center.x()) > w / 4 ||
+        std::abs(pos.y() - center.y()) > h / 4) {
+        mVeloxMouseLookRecentering = true;
+        QCursor::setPos(mapToGlobal(center));
+        mVeloxMouseLookLastLocal = center;
+    }
+    return true;
+}
+
+bool EmulatorQtWindow::shouldProcessMouseEvent(const QMouseEvent* event) {
+    if (!event) {
+        return false;
+    }
+    if (event->source() == Qt::MouseEventNotSynthesized) {
+        return true;
+    }
+    // Filter out system/Qt-synthesized mouse events only while a native
+    // TouchScreen or Tablet/Pen gesture is active or just ended (Windows Ink
+    // long-press / release synthesis window). Remote Desktop, mobile remote
+    // clients, and touch-to-mouse drivers deliver only synthesized mouse events
+    // (MI_WP_SIGNATURE) without native QTouchEvent/QTabletEvent and must pass.
+    constexpr qint64 kNativeTouchPenCooldownMs = 250;
+    constexpr qint64 kNativeActiveStaleMs = 5000;
+    if (mNativeTouchOrPenActive) {
+        if (!mNativeTouchOrPenTimer.isValid() ||
+            mNativeTouchOrPenTimer.elapsed() > kNativeActiveStaleMs) {
+            mNativeTouchOrPenActive = false;
+        } else {
+            return false;
+        }
+    }
+    if (mNativeTouchOrPenTimer.isValid() &&
+        mNativeTouchOrPenTimer.elapsed() <= kNativeTouchPenCooldownMs) {
+        return false;
+    }
+    return true;
+}
