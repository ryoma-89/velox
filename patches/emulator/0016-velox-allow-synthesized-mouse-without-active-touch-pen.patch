+bool EmulatorQtWindow::shouldProcessMouseEvent(const QMouseEvent* event) {
+    if (!event) {
+        return false;
+    }
+    if (event->source() == Qt::MouseEventNotSynthesized) {
+        return true;
+    }
+    // Filter out system/Qt-synthesized mouse events only while a native
+    // TouchScreen or Tablet/Pen gesture is active or just ended (Windows Ink
+    // long-press / release synthesis window). Remote Desktop, mobile remote
+    // clients, and touch-to-mouse drivers deliver only synthesized mouse events
+    // (MI_WP_SIGNATURE) without native QTouchEvent/QTabletEvent and must pass.
+    constexpr qint64 kNativeTouchPenCooldownMs = 250;
+    constexpr qint64 kNativeActiveStaleMs = 5000;
+    if (mNativeTouchOrPenActive) {
+        if (!mNativeTouchOrPenTimer.isValid() ||
+            mNativeTouchOrPenTimer.elapsed() > kNativeActiveStaleMs) {
+            mNativeTouchOrPenActive = false;
+        } else {
+            return false;
+        }
+    }
+    if (mNativeTouchOrPenTimer.isValid() &&
+        mNativeTouchOrPenTimer.elapsed() <= kNativeTouchPenCooldownMs) {
+        return false;
+    }
+    return true;
+}
