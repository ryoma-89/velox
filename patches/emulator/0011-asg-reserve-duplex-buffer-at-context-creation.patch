+        // A v1 guest uses the first half exactly as before.
+        const uint64_t size = sGlobals->perContextBufferSize();
+        const char* duplex = std::getenv("VELOX_ASG_DUPLEX");
+        const auto* options = getConsoleAgents()->settings->android_cmdLineOptions();
+        if (duplex && !std::strcmp(duplex, "1") && options && options->no_snapstorage &&
+            size >= kAsgPageSize && size <= kAsgBlockSize / 2 && !(size & (size - 1))) {
+            mBufferAllocation = sGlobals->allocBuffer(2);
+            mDuplexReserved = mBufferAllocation.buffer != nullptr;
+        }
+        if (!mBufferAllocation.buffer) {
+            mBufferAllocation = sGlobals->allocBuffer();
+        }
     }
 
