 static struct whpx_vcpu *get_whpx_vcpu(CPUState *cpu)
 {
     return cpu->whpx_vcpu;
+}
+
+static void whpx_count_exit(struct whpx_vcpu *vcpu)
+{
+    enum WhpxExitCounter counter;
+    switch (vcpu->exit_ctx.ExitReason) {
+    case WHvRunVpExitReasonMemoryAccess:
+        counter = WHPX_EXIT_MMIO;
+        break;
+    case WHvRunVpExitReasonX64IoPortAccess:
+        counter = WHPX_EXIT_PORT_IO;
+        break;
+    case WHvRunVpExitReasonX64InterruptWindow:
+        counter = WHPX_EXIT_INTERRUPT_WINDOW;
+        break;
+    case WHvRunVpExitReasonX64Halt:
+        counter = WHPX_EXIT_HALT;
+        break;
+    case WHvRunVpExitReasonCanceled:
+        counter = WHPX_EXIT_CANCEL;
+        break;
+    case WHvRunVpExitReasonX64MsrAccess:
+        counter = WHPX_EXIT_MSR;
+        break;
+    case WHvRunVpExitReasonX64Cpuid:
+        counter = WHPX_EXIT_CPUID;
+        break;
+    default:
+        counter = WHPX_EXIT_OTHER;
+        break;
+    }
+
+    /* Only this vCPU writes its counters. The main loop samples them. */
+    atomic_set(&vcpu->exit_counts[counter], atomic_read(&vcpu->exit_counts[counter]) + 1);
+}
+
+static void whpx_log_exit_counts(void *opaque)
+{
+    uint64_t sums[WHPX_EXIT_COUNT] = {0};
+    CPUState *cpu;
+    CPU_FOREACH(cpu) {
+        struct whpx_vcpu *vcpu = get_whpx_vcpu(cpu);
+        if (vcpu) {
+            for (unsigned i = 0; i < WHPX_EXIT_COUNT; ++i) {
+                sums[i] += atomic_read(&vcpu->exit_counts[i]);
+            }
+        }
+    }
+    fprintf(stderr, "VELOX_WHPX_EXITS host_ms=%" PRId64 " mmio=%" PRIu64 " port_io=%" PRIu64
+            " interrupt_window=%" PRIu64 " halt=%" PRIu64 " cancel=%" PRIu64
+            " msr=%" PRIu64 " cpuid=%" PRIu64 " other=%" PRIu64 "\n",
+            qemu_clock_get_ms(QEMU_CLOCK_HOST), sums[WHPX_EXIT_MMIO], sums[WHPX_EXIT_PORT_IO],
+            sums[WHPX_EXIT_INTERRUPT_WINDOW], sums[WHPX_EXIT_HALT], sums[WHPX_EXIT_CANCEL],
+            sums[WHPX_EXIT_MSR], sums[WHPX_EXIT_CPUID], sums[WHPX_EXIT_OTHER]);
+    timer_mod(&whpx_exit_counts_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 5000);
 }
 
 static WHV_X64_SEGMENT_REGISTER whpx_seg_q2h(const SegmentCache *qs, int v86,
@@ -1124,6 +1195,9 @@
             break;
         }
 
+        if (whpx_collect_exit_counts) {
+            whpx_count_exit(vcpu);
+        }
         whpx_vcpu_post_run(cpu);
 
         switch (vcpu->exit_ctx.ExitReason) {
@@ -1937,6 +2011,11 @@
     whpx_memory_init();
 
     cpu_interrupt_handler = whpx_handle_interrupt;
+    whpx_collect_exit_counts = g_strcmp0(g_getenv("VELOX_WHPX_EXIT_STATS"), "1") == 0;
+    if (whpx_collect_exit_counts) {
+        timer_init_ms(&whpx_exit_counts_timer, QEMU_CLOCK_REALTIME, whpx_log_exit_counts, NULL);
+        timer_mod(&whpx_exit_counts_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 5000);
+    }
 
     printf("Windows Hypervisor Platform accelerator is operational\n");
     return 0;
