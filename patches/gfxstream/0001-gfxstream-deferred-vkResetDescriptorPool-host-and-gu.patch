diff --git a/host/vulkan/vk_decoder_global_state.cpp b/host/vulkan/vk_decoder_global_state.cpp
index f1a8cab..78b500b 100644
--- a/host/vulkan/vk_decoder_global_state.cpp
+++ b/host/vulkan/vk_decoder_global_state.cpp
@@ -10085,6 +10085,62 @@ class VkDecoderGlobalState::Impl {
             pDescriptorWriteStartingIndices, pendingDescriptorWriteCount, pPendingDescriptorWrites);
     }
 
+    // Deferred vkResetDescriptorPool (VulkanBatchedDescriptorSetUpdate): apply the guest's reset
+    // of each pool whose reset epoch is newer than the last applied one, then service the commit,
+    // all under mMutex. Guest commands are executed in the guest's encoding order across streams
+    // (sequence numbers), and a commit of a reset pool always carries that pool's epoch, so the
+    // reset happens exactly once and before any allocation made after it in the guest.
+    void on_vkQueueCommitDescriptorSetUpdates2GOOGLE(
+        gfxstream::base::BumpPool* pool, VkSnapshotApiCallHandle apiCallHandle, VkQueue boxed_queue,
+        uint32_t descriptorPoolCount, const VkDescriptorPool* pDescriptorPools,
+        const uint64_t* pDescriptorPoolResetEpochs, uint32_t descriptorSetCount,
+        const VkDescriptorSetLayout* pDescriptorSetLayouts, const uint64_t* pDescriptorSetPoolIds,
+        const uint32_t* pDescriptorSetWhichPool, const uint32_t* pDescriptorSetPendingAllocation,
+        const uint32_t* pDescriptorWriteStartingIndices, uint32_t pendingDescriptorWriteCount,
+        const VkWriteDescriptorSet* pPendingDescriptorWrites) {
+        std::lock_guard<std::mutex> lock(mMutex);
+
+        auto queue = unbox_VkQueue(boxed_queue);
+        auto vk = dispatch_VkQueue(boxed_queue);
+
+        VkDevice device = VK_NULL_HANDLE;
+        auto* queueInfo = gfxstream::base::find(mQueueInfo, queue);
+        if (queueInfo) {
+            device = queueInfo->device;
+        } else {
+            GFXSTREAM_FATAL("VkQueue:%p (boxed-VkQueue:%p) with no device registered.",
+                            queue, boxed_queue);
+        }
+
+        for (uint32_t i = 0; i < descriptorPoolCount; ++i) {
+            auto* poolInfo = gfxstream::base::find(mDescriptorPoolInfo, pDescriptorPools[i]);
+            if (!poolInfo) {
+                GFXSTREAM_ERROR("Cannot find info for VkDescriptorPool:%p", pDescriptorPools[i]);
+                return;
+            }
+            const uint64_t epoch = pDescriptorPoolResetEpochs[i];
+            if (epoch <= poolInfo->appliedResetEpoch) continue;
+            // The application waited for all uses of the pool's sets before
+            // vkResetDescriptorPool() (VUID-vkResetDescriptorPool-descriptorPool-00313).
+            VkResult res = vk->vkResetDescriptorPool(poolInfo->device, pDescriptorPools[i], 0);
+            if (res != VK_SUCCESS) {
+                // The only result the specification defines is VK_SUCCESS; anything else is a
+                // driver failure that the guest can no longer be told about at reset time.
+                GFXSTREAM_ERROR("Deferred vkResetDescriptorPool(%p) failed: %d",
+                                pDescriptorPools[i], res);
+                return;
+            }
+            resetDescriptorPoolInfoLocked(pDescriptorPools[i]);
+            poolInfo->appliedResetEpoch = epoch;
+        }
+
+        on_vkQueueCommitDescriptorSetUpdatesGOOGLELocked(
+            pool, apiCallHandle, vk, device, descriptorPoolCount, pDescriptorPools,
+            descriptorSetCount, pDescriptorSetLayouts, pDescriptorSetPoolIds,
+            pDescriptorSetWhichPool, pDescriptorSetPendingAllocation,
+            pDescriptorWriteStartingIndices, pendingDescriptorWriteCount, pPendingDescriptorWrites);
+    }
+
     void on_vkQueueCommitDescriptorSetUpdatesGOOGLELocked(
         gfxstream::base::BumpPool* pool, VkSnapshotApiCallHandle apiCallHandle, VulkanDispatch* vk,
         VkDevice device, uint32_t descriptorPoolCount, const VkDescriptorPool* pDescriptorPools,
@@ -13468,6 +13524,21 @@ void VkDecoderGlobalState::on_vkQueueCommitDescriptorSetUpdatesGOOGLE(
         pendingDescriptorWriteCount, pPendingDescriptorWrites);
 }
 
+void VkDecoderGlobalState::on_vkQueueCommitDescriptorSetUpdates2GOOGLE(
+    gfxstream::base::BumpPool* pool, VkSnapshotApiCallHandle apiCallHandle, VkQueue queue,
+    uint32_t descriptorPoolCount, const VkDescriptorPool* pDescriptorPools,
+    const uint64_t* pDescriptorPoolResetEpochs, uint32_t descriptorSetCount,
+    const VkDescriptorSetLayout* pDescriptorSetLayouts, const uint64_t* pDescriptorSetPoolIds,
+    const uint32_t* pDescriptorSetWhichPool, const uint32_t* pDescriptorSetPendingAllocation,
+    const uint32_t* pDescriptorWriteStartingIndices, uint32_t pendingDescriptorWriteCount,
