--- a/host/vulkan/device_op_tracker.cpp
+++ b/host/vulkan/device_op_tracker.cpp
@@ -45,6 +45,8 @@ void DeviceOpTracker::AddPendingGarbage(DeviceOpWaitable waitable, VkFence fence
         .obj = fence,
