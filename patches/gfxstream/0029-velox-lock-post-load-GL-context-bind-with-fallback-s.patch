diff --git a/host/gl/emulation_gl.cpp b/host/gl/emulation_gl.cpp
index c4a3f65..604443f 100644
--- a/host/gl/emulation_gl.cpp
+++ b/host/gl/emulation_gl.cpp
@@ -1213,6 +1213,59 @@ bool EmulationGl::bindContext(HandleType contextHandle, HandleType drawSurfaceHa
     return true;
 }
 
+bool EmulationGl::postLoadBindContext(HandleType contextHandle, HandleType drawSurfaceHandle,
+                                      HandleType readSurfaceHandle) {
+    if (!contextHandle) {
+        return bindContext(0, 0, 0);
+    }
+    EmulatedEglContextPtr ctx = getContext(contextHandle);
+    if (!ctx) {
+        return false;
+    }
+
+    HandleType effectiveDraw = (drawSurfaceHandle && getWindowSurface(drawSurfaceHandle))
+                                   ? drawSurfaceHandle
+                                   : 0;
+    HandleType effectiveRead = (readSurfaceHandle && getWindowSurface(readSurfaceHandle))
+                                   ? readSurfaceHandle
+                                   : 0;
+
+    // EGL spec §3.5.5 allows eglDestroySurface() while a surface is still current on a thread:
+    // the surface is erased from mWindows (so it is not saved in snapshots), yet the thread
+    // keeps its context bound until the next eglMakeCurrent(). If snapshot load restores a
+    // thread whose bound surface was deferred-deleted, create a compatible 1x1 fallback
+    // pbuffer surface so eglMakeCurrent() succeeds instead of leaving TLS glesContext null.
+    if (!effectiveDraw || !effectiveRead) {
+        const size_t numConfigs = mEmulatedEglConfigs ? mEmulatedEglConfigs->size() : 0;
+        for (size_t i = 0; i < numConfigs; ++i) {
+            const auto* cfg = mEmulatedEglConfigs->get(static_cast<uint32_t>(i));
+            if (!cfg) continue;
+            HandleType fallbackHandle = mGlobalState->genHandleLocked();
+            auto fallbackWin = EmulatedEglWindowSurface::create(
+                mEglDisplay, cfg->getHostEglConfig(), 1, 1, fallbackHandle);
+            if (!fallbackWin) continue;
+            mWindows[fallbackHandle] = {std::move(fallbackWin), 0};
+            const HandleType tryDraw = effectiveDraw ? effectiveDraw : fallbackHandle;
+            const HandleType tryRead = effectiveRead ? effectiveRead : fallbackHandle;
+            if (bindContext(contextHandle, tryDraw, tryRead)) {
+                RenderThreadInfoGl* tinfo = RenderThreadInfoGl::get();
+                if (tinfo) {
+                    if (tinfo->m_puid) {
+                        mProcOwnedEmulatedEglWindowSurfaces[tinfo->m_puid].insert(fallbackHandle);
+                    } else {
+                        tinfo->m_windowSet.insert(fallbackHandle);
+                    }
+                }
+                return true;
+            }
+            mWindows.erase(fallbackHandle);
+        }
+        return false;
+    }
+
+    return bindContext(contextHandle, effectiveDraw, effectiveRead);
+}
+
 void EmulationGl::preSave(Stream* stream, const gfxstream::ITextureSaverPtr& textureSaver) {
     if (s_egl.eglPreSaveContext && s_egl.eglSaveAllImages) {
         for (const auto& ctx : mContexts) {
