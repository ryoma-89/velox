diff --git a/host/gl/glestranslator/gles_v2/gles_v30_imp.cpp b/host/gl/glestranslator/gles_v2/gles_v30_imp.cpp
index 1d798d0..f99e3eb 100644
--- a/host/gl/glestranslator/gles_v2/gles_v30_imp.cpp
+++ b/host/gl/glestranslator/gles_v2/gles_v30_imp.cpp
@@ -404,12 +404,34 @@ public:
 
     GLsync create(GLsync newHostSync) {
         GLsync res = (GLsync)(uintptr_t)mNameCounter;
+        mStaleSyncs.erase(res);
         mSyncs[res] = newHostSync;
         mNameCounter++;
         if (!mNameCounter) mNameCounter = 0x1000;
         return res;
     }
 
+    void markPreSnapshotSave() {
+        for (const auto& kv : mSyncs) {
+            mStaleSyncs.insert(kv.first);
+        }
+    }
+
+    void onSnapshotLoad() {
+        for (const auto& kv : mSyncs) {
+            mStaleSyncs.insert(kv.first);
+        }
+        mSyncs.clear();
+    }
+
+    bool isStale(GLsync guestSync) const {
+        return mStaleSyncs.find(guestSync) != mStaleSyncs.end();
+    }
+
+    bool removeStale(GLsync guestSync) {
+        return mStaleSyncs.erase(guestSync) > 0;
+    }
+
     GLsync lookupWithError(GLsync guestSync, GLint* err) {
         *err = GL_NO_ERROR;
         GLsync host = (GLsync)0x0;
@@ -445,13 +467,15 @@ public:
     }
 
     bool isSync(GLsync guestSync) {
-        return mSyncs.find(guestSync) != mSyncs.end();
+        return mSyncs.find(guestSync) != mSyncs.end() ||
+               mStaleSyncs.find(guestSync) != mStaleSyncs.end();
     }
 
     gfxstream::base::Lock& lock() { return mLock; }
 
 private:
     std::unordered_map<GLsync, GLsync> mSyncs;
+    std::unordered_set<GLsync> mStaleSyncs;
     mutable gfxstream::base::Lock mLock;
     uint32_t mNameCounter = 0x1;
 };
@@ -461,6 +485,16 @@ static GuestSyncs* sSyncs() {
     return s;
 }
 
+static void markGuestSyncsPreSnapshotSave() {
+    gfxstream::base::AutoLock lock(sSyncs()->lock());
+    sSyncs()->markPreSnapshotSave();
+}
+
+static void markGuestSyncsOnSnapshotLoad() {
+    gfxstream::base::AutoLock lock(sSyncs()->lock());
+    sSyncs()->onSnapshotLoad();
+}
+
 static GLsync internal_glFenceSync(GLenum condition, GLbitfield flags) {
     GET_CTX_V2_RET(0);
     if (!ctx->dispatcher().glFenceSync) {
@@ -539,6 +573,10 @@ GL_APICALL GLenum GL_APIENTRY glClientWaitSync(GLsync wait_on, GLbitfield flags,
 
     gfxstream::base::AutoLock lock(sSyncs()->lock());
     GLsync hostSync = sSyncs()->lookupWithError(wait_on, &err);
+    if (err != GL_NO_ERROR && sSyncs()->isStale(wait_on)) {
+        // Pre-snapshot syncs were already completed by finishBeforeSnapshot() -> glFinish().
+        return GL_ALREADY_SIGNALED;
+    }
     RET_AND_SET_ERROR_IF(err != GL_NO_ERROR, err, GL_WAIT_FAILED);
     return internal_glClientWaitSync(hostSync, flags, timeout);
 }
@@ -549,6 +587,9 @@ GL_APICALL void GL_APIENTRY glWaitSync(GLsync wait_on, GLbitfield flags, GLuint6
 
     gfxstream::base::AutoLock lock(sSyncs()->lock());
     GLsync hostSync = sSyncs()->lookupWithError(wait_on, &err);
+    if (err != GL_NO_ERROR && sSyncs()->isStale(wait_on)) {
+        return;
+    }
     SET_ERROR_IF(err != GL_NO_ERROR, err);
     internal_glWaitSync(hostSync, flags, timeout);
 }
@@ -559,6 +600,9 @@ GL_APICALL void GL_APIENTRY glDeleteSync(GLsync to_delete) {
 
     gfxstream::base::AutoLock lock(sSyncs()->lock());
     GLsync hostSync = sSyncs()->removeWithError(to_delete, &err);
+    if (err != GL_NO_ERROR && sSyncs()->removeStale(to_delete)) {
+        return;
+    }
     SET_ERROR_IF(err != GL_NO_ERROR, err);
     internal_glDeleteSync(hostSync);
 }
@@ -576,6 +620,29 @@ GL_APICALL void GL_APIENTRY glGetSynciv(GLsync sync, GLenum pname, GLsizei bufSi
 
     gfxstream::base::AutoLock lock(sSyncs()->lock());
     GLsync hostSync = sSyncs()->lookupWithError(sync, &err);
+    if (err != GL_NO_ERROR && sSyncs()->isStale(sync)) {
+        if (bufSize < 1 || !values) return;
+        if (length) *length = 1;
+        switch (pname) {
+            case GL_OBJECT_TYPE:
+                *values = GL_SYNC_FENCE;
+                break;
+            case GL_SYNC_CONDITION:
+                *values = GL_SYNC_GPU_COMMANDS_COMPLETE;
+                break;
+            case GL_SYNC_FLAGS:
+                *values = 0;
+                break;
+            case GL_SYNC_STATUS:
+                *values = GL_SIGNALED;
+                break;
+            default:
+                if (length) *length = 0;
+                ctx->setGLerror(GL_INVALID_ENUM);
+                break;
+        }
+        return;
+    }
     SET_ERROR_IF(err != GL_NO_ERROR, err);
     ctx->dispatcher().glGetSynciv(hostSync, pname, bufSize, length, values);
 }
diff --git a/host/gl/render_thread_info_gl.cpp b/host/gl/render_thread_info_gl.cpp
index 3b4fdb4..2fdbe60 100644
--- a/host/gl/render_thread_info_gl.cpp
+++ b/host/gl/render_thread_info_gl.cpp
@@ -55,6 +55,14 @@ void RenderThreadInfoGl::finishBeforeSnapshot() {
     if (!currContext) {
         return;
     }
+    // A thread restored from an earlier snapshot that stayed idle until the next savevm
+    // has currContext populated from onLoad() before postLoadRefreshCurrentContextSurfacePtrs()
+    // ever bound it via eglMakeCurrent(). In that state no commands were submitted on this
+    // thread since the prior snapshot, and calling glFinish() with a null TLS context logs
+    // spurious "error null ctx".
+    if (s_egl.eglGetCurrentContext && s_egl.eglGetCurrentContext() == EGL_NO_CONTEXT) {
+        return;
+    }
     // The snapshot is taken from a different context (and thread). Pending
     // commands in this context - texture uploads, draws into EGLImage
     // backed textures - are not guaranteed to be visible there until they
