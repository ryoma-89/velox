+#pragma once
+
+// Velox fence completion table (VELOX_FENCE_SHARED=1, guest debug.velox.fence_shared=1).
+//
+// The host publishes, for fences submitted through an ASG context, "this fence (boxed handle)
+// reached VK_SUCCESS natively in reset epoch E" into a small table in the tail of that context's
+// ring storage (the third page, after the from_host_large_xfer ring header, which only uses its
+// first 2308 bytes). The guest may then answer vkGetFenceStatus / vkWaitForFences without a
+// round trip, but only when the slot names its fence and the epoch it expects (the number of
+// vkResetFences it issued for the fence). Everything else falls back to the RPC.
+//
+// Isolation: the table is written by the host and never read by it; the host's decisions use
+// its own state (FenceInfo, the watcher). A guest that scribbles over the table can only make
+// its own fence queries wrong. Only a native VK_SUCCESS observed by the host is published, so
+// CPU-side submission is never reported as GPU completion.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <vulkan/vulkan.h>
+
+namespace gfxstream {
+
+// Defined in ring_stream.cpp (names the thread; role "fencewatch").
+void veloxPlaceCurrentThread(const char* role);
+
+// Layout shared with the guest (Mesa gfxstream AddressSpaceStream). Offsets are within the
+// 4 KiB page that holds the from_host_large_xfer ring header.
+constexpr uint32_t kVeloxFenceTableOffset = 2560;
+constexpr uint32_t kVeloxFenceTableMagic = 0x54465856;  // "VXFT"
+constexpr uint32_t kVeloxFenceTableVersion = 1;
+constexpr uint32_t kVeloxFenceTableSlots = 64;
+
+struct VeloxFenceTableHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t slots;
+    uint32_t reserved[13];
+};
+
+struct VeloxFenceSlot {
+    uint32_t seq;    // odd while the host rewrites the slot (seqlock)
+    uint32_t epoch;  // reset epoch of the completion
+    uint64_t handle; // boxed (guest-visible) fence handle, 0 = empty
+};
+
+static_assert(sizeof(VeloxFenceTableHeader) == 64, "layout");
+static_assert(sizeof(VeloxFenceSlot) == 16, "layout");
+static_assert(kVeloxFenceTableOffset + sizeof(VeloxFenceTableHeader) +
+                      kVeloxFenceTableSlots * sizeof(VeloxFenceSlot) <= 4096,
+              "the table must fit in the page");
+
+inline uint32_t veloxFenceSlotIndex(uint64_t handle) {
+    return static_cast<uint32_t>((handle * 0x9E3779B97F4A7C15ull) >> 58) &
+           (kVeloxFenceTableSlots - 1);
+}
+
+class VeloxFenceTable {
+   public:
+    // |page| is the guest-shared page (host mapping of guest RAM); the table lives at
+    // kVeloxFenceTableOffset. The constructor clears stale contents of a reused page first.
+    explicit VeloxFenceTable(uint8_t* page) : mBase(page + kVeloxFenceTableOffset) {
+        std::memset(mBase, 0, sizeof(VeloxFenceTableHeader) +
+                                  kVeloxFenceTableSlots * sizeof(VeloxFenceSlot));
+        auto* header = reinterpret_cast<VeloxFenceTableHeader*>(mBase);
+        header->version = kVeloxFenceTableVersion;
+        header->slots = kVeloxFenceTableSlots;
+        __atomic_store_n(&header->magic, kVeloxFenceTableMagic, __ATOMIC_RELEASE);
+    }
+
+    // The ring storage is freed with the ASG context; nothing is written after this.
+    void invalidate() {
+        std::lock_guard<std::mutex> lock(mMutex);
+        if (!mValid) return;
+        auto* header = reinterpret_cast<VeloxFenceTableHeader*>(mBase);
+        __atomic_store_n(&header->magic, 0u, __ATOMIC_RELEASE);
+        mValid = false;
+    }
+
+    void publish(uint64_t handle, uint32_t epoch) {
+        if (!handle) return;
+        std::lock_guard<std::mutex> lock(mMutex);
+        if (!mValid) return;
+        writeSlot(slot(handle), handle, epoch);
+        ++mPublished;
+    }
+
+    // Forget |handle| (reset or destroy) so that its old completion is never reused.
+    void clear(uint64_t handle) {
+        if (!handle) return;
+        std::lock_guard<std::mutex> lock(mMutex);
+        if (!mValid) return;
+        VeloxFenceSlot* s = slot(handle);
+        if (__atomic_load_n(&s->handle, __ATOMIC_RELAXED) == handle) writeSlot(s, 0, 0);
+    }
+
+    unsigned long long published() const { return mPublished; }
+
+   private:
+    VeloxFenceSlot* slot(uint64_t handle) {
+        return reinterpret_cast<VeloxFenceSlot*>(mBase + sizeof(VeloxFenceTableHeader)) +
+               veloxFenceSlotIndex(handle);
+    }
+
+    // Seqlock: only the host writes (under mMutex), so the counter is even between writes.
+    static void writeSlot(VeloxFenceSlot* s, uint64_t handle, uint32_t epoch) {
+        const uint32_t seq = __atomic_load_n(&s->seq, __ATOMIC_RELAXED) & ~1u;
+        __atomic_store_n(&s->seq, seq + 1, __ATOMIC_RELAXED);
+        __atomic_thread_fence(__ATOMIC_RELEASE);
+        __atomic_store_n(&s->handle, handle, __ATOMIC_RELAXED);
+        __atomic_store_n(&s->epoch, epoch, __ATOMIC_RELAXED);
+        __atomic_store_n(&s->seq, seq + 2, __ATOMIC_RELEASE);
+    }
+
+    std::mutex mMutex;
+    uint8_t* mBase;
+    bool mValid = true;
+    unsigned long long mPublished = 0;
+};
+
+// The table of the ASG context whose RenderThread is decoding on this thread (null for pipe
+// transports or when the feature is off).
+inline thread_local std::shared_ptr<VeloxFenceTable> tVeloxCurrentFenceTable;
+
+// Per-device thread that waits for submitted fences natively and publishes completions.
+// Fences are only waited on between add() and cancel(); cancel() returns once no native call
+// on the fence is in progress, so the caller may then reset or destroy it.
+class VeloxFenceWatcher {
+   public:
+    struct Entry {
+        VkFence fence;    // native
+        uint64_t boxed;   // guest-visible handle
+        uint32_t epoch;
+        std::shared_ptr<VeloxFenceTable> table;
+        std::chrono::steady_clock::time_point eligible{};  // set by add()
+    };
+
+    // A fence is waited on only once it has been pending for |delay| without anyone else
+    // observing its completion: a guest that waits for its fence right away (a synchronous
+    // frame) gets the answer from its own RPC, and the watcher then never touches the fence,
+    // so it adds no concurrent native wait and no cancel() wait to that path.
+    VeloxFenceWatcher(VkDevice device, PFN_vkWaitForFences wait, PFN_vkGetFenceStatus status,
+                      std::chrono::microseconds delay)
+        : mDevice(device), mWait(wait), mStatus(status), mDelay(delay), mThread([this] { run(); }) {}
+
+    ~VeloxFenceWatcher() { stop(); }
+
+    void stop() {
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            mStop = true;
+            mPending.clear();
+        }
+        mCv.notify_all();
+        if (mThread.joinable()) mThread.join();
+    }
+
+    // Never wakes the watcher: a submission must not pay for a thread wake-up. The watcher
+    // looks at the list every kPollPeriod while it is not empty.
+    void add(Entry entry) {
+        entry.eligible = std::chrono::steady_clock::now() + mDelay;
+        std::lock_guard<std::mutex> lock(mMutex);
+        if (mStop || mLost) return;
+        for (auto& e : mPending) {
+            if (e.fence == entry.fence) {
+                e = std::move(entry);
+                return;
+            }
+        }
+        mPending.push_back(std::move(entry));
+    }
+
+    // The host observed the fence's completion itself (and published it): stop watching it
+    // without waiting for a native call the watcher may have in progress.
+    void observed(VkFence fence) {
+        std::lock_guard<std::mutex> lock(mMutex);
+        for (size_t i = 0; i < mPending.size(); ++i) {
+            if (mPending[i].fence == fence) {
+                mPending.erase(mPending.begin() + i);
+                return;
+            }
+        }
+    }
+
+    void cancel(VkFence fence) {
+        std::unique_lock<std::mutex> lock(mMutex);
+        for (size_t i = 0; i < mPending.size(); ++i) {
+            if (mPending[i].fence == fence) {
+                mPending.erase(mPending.begin() + i);
+                break;
+            }
+        }
+        mCv.wait(lock, [&] {
+            for (VkFence f : mInWait) {
+                if (f == fence) return false;
+            }
+            return true;
+        });
+    }
+
+    unsigned long long completions() const { return mCompletions.load(std::memory_order_relaxed); }
+
+   private:
+    void run() {
+        setThreadName();
+        std::vector<VkFence> batch;
+        std::vector<VkFence> done;
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lock(mMutex);
+                for (;;) {
+                    if (mStop) return;
+                    const auto now = std::chrono::steady_clock::now();
+                    auto next = now + kPollPeriod;
+                    batch.clear();
+                    if (!mLost) {
+                        for (const auto& e : mPending) {
+                            if (e.eligible <= now) {
+                                if (batch.size() < 64) batch.push_back(e.fence);
+                            } else if (e.eligible < next) {
+                                next = e.eligible;
+                            }
+                        }
+                    }
+                    if (!batch.empty()) break;
+                    // Idle: sleep a period at a time (add() does not notify); stop() notifies.
+                    mCv.wait_until(lock, next);
+                }
+                mInWait = batch;
+            }
+            done.clear();
+            // Wait for any of them, in short slices so that cancel() and stop() are prompt.
+            VkResult result = mWait(mDevice, static_cast<uint32_t>(batch.size()), batch.data(),
+                                    VK_FALSE, 2000000ull);
+            bool lost = result == VK_ERROR_DEVICE_LOST;
+            if (result == VK_SUCCESS) {
+                for (VkFence f : batch) {
+                    const VkResult s = mStatus(mDevice, f);
+                    if (s == VK_SUCCESS) {
+                        done.push_back(f);
+                    } else if (s == VK_ERROR_DEVICE_LOST) {
+                        lost = true;
+                    }
+                }
+            }
+            {
+                std::lock_guard<std::mutex> lock(mMutex);
+                if (lost) {
+                    // Never publish after a device loss; the guest's RPCs report the loss.
+                    mLost = true;
+                    mPending.clear();
+                }
+                for (VkFence f : done) {
+                    for (size_t i = 0; i < mPending.size(); ++i) {
+                        if (mPending[i].fence != f) continue;
+                        mPending[i].table->publish(mPending[i].boxed, mPending[i].epoch);
+                        mCompletions.fetch_add(1, std::memory_order_relaxed);
+                        mPending.erase(mPending.begin() + i);
+                        break;
+                    }
+                }
+                mInWait.clear();
+            }
+            mCv.notify_all();
+            if (result != VK_SUCCESS && result != VK_TIMEOUT && !lost) {
+                // Unexpected error: back off instead of spinning on it.
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+        }
+    }
+
+    static void setThreadName() { veloxPlaceCurrentThread("fencewatch"); }
+
+    VkDevice mDevice;
+    PFN_vkWaitForFences mWait;
+    PFN_vkGetFenceStatus mStatus;
+    std::chrono::microseconds mDelay;
+    static constexpr std::chrono::microseconds kPollPeriod{250};
+    std::mutex mMutex;
+    std::condition_variable mCv;
+    std::vector<Entry> mPending;
+    std::vector<VkFence> mInWait;
+    bool mStop = false;
+    bool mLost = false;
+    std::atomic<unsigned long long> mCompletions{0};
+    std::thread mThread;
+};
+
+}  // namespace gfxstream
