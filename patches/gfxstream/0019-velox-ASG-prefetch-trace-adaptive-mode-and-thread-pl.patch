+// AHEAD=3: RenderThread ran out of packets while the prefetch thread is receiving (not polling
+// an empty ring) on a hot stream: wait for it to publish instead of taking the rings over, so
+// RenderThread does not copy the rest of the packet itself. Gives up (and takes over) when the
+// prefetch thread starts to poll, the stream cools or the wait budget runs out.
+bool RingStream::waitForInflightPacket(uint64_t pos, size_t minSize) {
+    if (mPrefetchAhead != 3 || !mPrefetchWaitNs || !mPrefetchThread.joinable()) return false;
+    if (mProducerPolling.load(std::memory_order_acquire)) return false;
+    const uint64_t start = monotonicNs();
+    if (start >= mHotUntilNs.load(std::memory_order_relaxed)) return false;
+    ++mPrefetchWaits;
+    trace(kTraceWaitBegin, pos, static_cast<uint32_t>(minSize));
+    bool served = false;
+    uint64_t now = start;
+    for (uint32_t i = 0;; ++i) {
+        if (mPublishedEnd.load(std::memory_order_acquire) - pos >= minSize) {
+            served = true;
+            break;
+        }
+        if (mProducerPolling.load(std::memory_order_acquire) || prefetchStopping()) break;
+        if ((i & 63) == 63) {
+            now = monotonicNs();
+            if (now - start >= mPrefetchWaitNs) break;
+        }
+        ring_buffer_yield();
+    }
+    now = monotonicNs();
+    mPrefetchWaitNsTotal += now - start;
+    if (served) ++mPrefetchWaitHits;
+    trace(kTraceWaitEnd, mPublishedEnd.load(std::memory_order_relaxed), served ? 1 : 0);
+    return served;
+}
