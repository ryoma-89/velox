+void veloxPlaceCurrentThread(const char* role) {
+#ifdef _WIN32
+    const bool render = !std::strcmp(role, "render");
+    using SetDescription = HRESULT(WINAPI*)(HANDLE, PCWSTR);
+    static const auto setDescription = reinterpret_cast<SetDescription>(reinterpret_cast<void*>(
+        GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription")));
+    if (setDescription) {
+        setDescription(GetCurrentThread(), render ? L"gfxstream-render" : L"velox-asg-prefetch");
+    }
+    const char* value = std::getenv(render ? "VELOX_RENDER_AFFINITY" : "VELOX_PREFETCH_AFFINITY");
+    if (!value || !*value) return;
+    char* end = nullptr;
+    unsigned long long mask = std::strtoull(value, &end, 16);
+    if (end == value || *end) return;
+    DWORD_PTR processMask = 0;
+    DWORD_PTR systemMask = 0;
+    if (!GetProcessAffinityMask(GetCurrentProcess(), &processMask, &systemMask)) return;
+    mask &= processMask;
+    static std::atomic<int> logged{0};
+    const DWORD_PTR previous = mask ? SetThreadAffinityMask(GetCurrentThread(), mask) : 0;
+    if (logged.fetch_add(1, std::memory_order_relaxed) < 4) {
+        GFXSTREAM_INFO("VELOX_PLACEMENT role=%s mask=0x%llx process=0x%llx applied=%d", role, mask,
+                       static_cast<unsigned long long>(processMask), previous ? 1 : 0);
+    }
+#else
+    (void)role;
+#endif
+}
