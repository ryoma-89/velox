+// EfficiencyClass of each logical processor in processor group 0 (-1 = unknown).
+struct CpuClasses {
+    std::vector<int> byIndex;
+    int maxClass = -1;
+    int minClass = 256;
+};
+
+const CpuClasses& cpuClasses() {
+    static const CpuClasses classes = [] {
+        CpuClasses result;
+#ifdef _WIN32
+        // SYSTEM_CPU_SET_INFORMATION (CpuSetInformation), declared here so that the build does
+        // not depend on _WIN32_WINNT; the layout is fixed by the Windows ABI.
+        struct CpuSetEntry {
+            DWORD size;
+            DWORD type;
+            DWORD id;
+            WORD group;
+            BYTE logicalProcessorIndex;
+            BYTE coreIndex;
+            BYTE lastLevelCacheIndex;
+            BYTE numaNodeIndex;
+            BYTE efficiencyClass;
+            BYTE allFlags;
+            DWORD reserved;
+            DWORD64 allocationTag;
+        };
+        using GetCpuSets = BOOL(WINAPI*)(void*, ULONG, PULONG, HANDLE, ULONG);
+        auto get = reinterpret_cast<GetCpuSets>(reinterpret_cast<void*>(
+            GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetSystemCpuSetInformation")));
+        ULONG length = 0;
+        if (get) get(nullptr, 0, &length, GetCurrentProcess(), 0);
+        std::vector<unsigned char> buffer(length);
+        if (get && length && get(buffer.data(), length, &length, GetCurrentProcess(), 0)) {
+            for (ULONG offset = 0; offset + sizeof(DWORD) * 2 <= length;) {
+                CpuSetEntry entry{};
+                memcpy(&entry, buffer.data() + offset,
+                       std::min<size_t>(sizeof(entry), length - offset));
+                if (!entry.size) break;
+                if (entry.type == 0 /* CpuSetInformation */ && entry.group == 0) {
+                    const size_t index = entry.logicalProcessorIndex;
+                    if (index >= result.byIndex.size()) result.byIndex.resize(index + 1, -1);
+                    result.byIndex[index] = entry.efficiencyClass;
+                    result.maxClass = std::max<int>(result.maxClass, entry.efficiencyClass);
+                    result.minClass = std::min<int>(result.minClass, entry.efficiencyClass);
+                }
+                offset += entry.size;
+            }
+        }
+#endif
+        return result;
+    }();
+    return classes;
+}
+
 }  // namespace
 
 namespace gfxstream {
+
+int veloxOnPerformanceCore() {
+#ifdef _WIN32
+    const CpuClasses& classes = cpuClasses();
+    const DWORD index = GetCurrentProcessorNumber();
+    return index < classes.byIndex.size() && classes.byIndex[index] == classes.maxClass ? 1 : 0;
+#else
+    return 0;
+#endif
+}
