+uint32_t RingStream::availableReplyBytes() {
+    const auto& reply = mContext.from_host_large_xfer;
+    if (!mDuplex) return ring_buffer_available_write(reply.ring, &reply.view);
+
+    const uint32_t retired = __atomic_load_n(&reply.ring->read_pos, __ATOMIC_ACQUIRE);
+    const uint32_t outstanding = mReplyProduced - mReplyConsumed;
+    if (retired - mReplyConsumed > outstanding || outstanding >= reply.view.size) {
+        protocolError();
+        return 0;
+    }
+    mReplyConsumed = retired;
+    return reply.view.size - 1 - (mReplyProduced - mReplyConsumed);
+}
+
+bool RingStream::writeReply(const uint8_t* data, uint32_t size) {
+    auto& reply = mContext.from_host_large_xfer;
+    if (!mDuplex) return ring_buffer_view_write(reply.ring, &reply.view, data, size, 1) == 1;
+
+    const uint32_t offset = mReplyProduced & reply.view.mask;
+    const uint32_t first = std::min(size, reply.view.size - offset);
+    memcpy(reply.view.buf + offset, data, first);
+    if (first < size) memcpy(reply.view.buf, data + first, size - first);
+    mReplyProduced += size;
+    __atomic_store_n(&reply.ring->write_pos, mReplyProduced, __ATOMIC_RELEASE);
+    return true;
+}
