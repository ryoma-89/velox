 void RingStream::type3Read(
     uint32_t available,
-    size_t* count, char** current, const char* ptrEnd) {
-
-    uint32_t xferTotal = __atomic_load_n(&mContext.ring_config->transfer_size, __ATOMIC_ACQUIRE);
-    uint32_t maxCanRead = ptrEnd - *current;
-    uint32_t ringAvail = available;
-    uint32_t actuallyRead = std::min(ringAvail, std::min(xferTotal, maxCanRead));
-
-    // Decrement transfer_size before letting the guest proceed in ring_buffer funcs or we will race
-    // to the next time the guest sets transfer_size
-    __atomic_fetch_sub(&mContext.ring_config->transfer_size, actuallyRead, __ATOMIC_RELEASE);
-
-    ring_buffer_read_fully_with_abort(
-            mContext.to_host_large_xfer.ring,
-            &mContext.to_host_large_xfer.view,
-            *current, actuallyRead,
-            1, &mContext.ring_config->in_error);
+    size_t* count, char* current, const char* ptrEnd) {
+
+    auto* transferSize = &mContext.ring_config->transfer_size;
+    uint32_t xferTotal = __atomic_load_n(transferSize, __ATOMIC_ACQUIRE);
+    const size_t room = ptrEnd - current;
+    const uint32_t readSize = std::min<size_t>(std::min(available, xferTotal), room);
+
+    // Update the remaining byte count before advancing read_pos, which can
+    // let the guest start its next transfer. A corrupt cursor must never
+    // make the renderer block in a second wait that teardown cannot cancel.
+    if (!readSize || !__atomic_compare_exchange_n(transferSize, &xferTotal, xferTotal - readSize,
+                                                false, __ATOMIC_RELEASE, __ATOMIC_RELAXED) ||
+        ring_buffer_view_read(mContext.to_host_large_xfer.ring, &mContext.to_host_large_xfer.view,
+                              current, readSize, 1) != 1) {
+        protocolError();
+        return;
+    }
 
-    *current += actuallyRead;
-    *count += actuallyRead;
+    *count += readSize;
 }
 
