 }
 
+void SyncThread::triggerWaitVkFenceHint(VkFence vkFence, uint64_t generation,
+                                        uint64_t timeline) {
+    std::stringstream ss;
+    ss << "triggerWaitVkFenceHint vkFence=0x" << std::hex << reinterpret_cast<uintptr_t>(vkFence)
+       << " generation=" << std::dec << generation;
+    sendAsync(
+        [vkFence, generation, timeline](WorkerId) {
+            auto decoder = vk::VkDecoderGlobalState::get();
+            decoder->waitForFenceSubmission(vkFence, generation, kDefaultTimeoutNsecs);
+            gfxstream_sync_timeline_inc(timeline, kTimelineInterval);
+        },
+        ss.str());
+}
