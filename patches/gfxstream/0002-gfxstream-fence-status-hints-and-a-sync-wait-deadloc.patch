@@ -10565,6 +10580,47 @@ class VkDecoderGlobalState::Impl {
         });
     }
 
+    // Fence status hint: return once submission number |generation| of |fence| (1 = first
+    // submission after creation) is known to have completed: the fence signaled, was reset after
+    // that submission (a reset requires completion), was submitted again, or was destroyed.
+    // Errors and the overall timeout also return, so the waiting sync worker is never held for
+    // long; the guest confirms with vkGetFenceStatus before it reports the fence as signaled.
+    VkResult waitForFenceSubmission(VkFence fence, uint64_t generation, uint64_t timeoutNs) {
+        const auto deadline =
+            std::chrono::steady_clock::now() + std::chrono::nanoseconds(timeoutNs);
+        constexpr uint64_t kStepNs = 2000000;  // 2 ms
+        for (;;) {
+            VkDevice device = VK_NULL_HANDLE;
+            VulkanDispatch* vk = nullptr;
+            FenceInfo* info = nullptr;
+            {
+                std::lock_guard<std::mutex> lock(mMutex);
+                info = gfxstream::base::find(mFenceInfo, fence);
+                if (!info) return VK_SUCCESS;  // destroyed: nothing is pending on it
+                device = info->device;
+                vk = info->vk;
+            }
+            const uint64_t submits = info->submitCount.load();
+            if (submits > generation) return VK_SUCCESS;  // resubmitted: earlier one completed
+            if (submits == generation) {
+                if (info->resetCount.load() != info->resetCountAtLastSubmit.load()) {
+                    return VK_SUCCESS;  // reset after this submission
+                }
+                VkResult res = vk->vkWaitForFences(device, 1, &fence, VK_TRUE, kStepNs);
+                if (res != VK_TIMEOUT) return res;
+            } else {
+                // The submission has not been decoded yet (the hint travels through the sync
+                // device, the submission through the command stream).
+                std::unique_lock<std::mutex> lock(info->mutex);
+                info->cv.wait_for(lock, std::chrono::nanoseconds(kStepNs),
+                                  [info, generation] {
+                                      return info->submitCount.load() >= generation;
+                                  });
+            }
+            if (std::chrono::steady_clock::now() >= deadline) return VK_TIMEOUT;
+        }
+    }
+
     VkResult waitForFence(VkFence fence, uint64_t timeout) {
         VkDevice device;
         VulkanDispatch* vk;
@@ -13704,6 +13760,13 @@ VkResult VkDecoderGlobalState::on_vkSetDebugUtilsObjectTagEXT(
 
 void VkDecoderGlobalState::on_DeviceLost() { mImpl->on_DeviceLost(); }
 
+VkResult VkDecoderGlobalState::waitForFenceSubmission(VkFence boxed_fence, uint64_t generation,
+                                                      uint64_t timeoutNs) {
+    VkFence fence = unbox_VkFence(boxed_fence);
+    if (fence == VK_NULL_HANDLE) return VK_SUCCESS;
+    return mImpl->waitForFenceSubmission(fence, generation, timeoutNs);
+}
+
 VkResult VkDecoderGlobalState::waitForFence(VkFence boxed_fence, uint64_t timeout) {
     VkFence fence = unbox_VkFence(boxed_fence);
     return mImpl->waitForFence(fence, timeout);
