diff --git a/host/vulkan/velox_fence_shared.h b/host/vulkan/velox_fence_shared.h
index 6c1ad5a..2d7cbeb 100644
--- a/host/vulkan/velox_fence_shared.h
+++ b/host/vulkan/velox_fence_shared.h
@@ -93,6 +93,7 @@ class VeloxFenceTable {
     void invalidate() {
         std::lock_guard<std::mutex> lock(mMutex);
         if (!mValid) return;
+        mValidAtomic.store(false, std::memory_order_release);
         auto* header = reinterpret_cast<VeloxFenceTableHeader*>(mBase);
         __atomic_store_n(&header->magic, 0u, __ATOMIC_RELEASE);
         mValid = false;
@@ -109,6 +110,12 @@ class VeloxFenceTable {
     // Forget |handle| (reset or destroy) so that its old completion is never reused.
     void clear(uint64_t handle) {
         if (!handle) return;
+        // Fast check without mMutex: if this slot does not hold |handle|, nothing to clear.
+        // Only the host writes slots, and reset/destroy is externally synchronized with submit.
+        if (mValidAtomic.load(std::memory_order_acquire)) {
+            VeloxFenceSlot* s = slot(handle);
+            if (__atomic_load_n(&s->handle, __ATOMIC_RELAXED) != handle) return;
+        }
         std::lock_guard<std::mutex> lock(mMutex);
         if (!mValid) return;
         VeloxFenceSlot* s = slot(handle);
@@ -136,6 +143,7 @@ class VeloxFenceTable {
     std::mutex mMutex;
     uint8_t* mBase;
     bool mValid = true;
+    std::atomic<bool> mValidAtomic{true};
     unsigned long long mPublished = 0;
 };
 
@@ -243,15 +251,20 @@ class VeloxFenceWatcher {
     }
 
     // Non-blocking: remove |fence| from mPending so the watcher neither starts waiting on it
-    // nor publishes a stale completion from an in-flight batch. Safe under global mMutex.
-    void removePending(VkFence fence) {
+    // nor publishes a stale completion from an in-flight batch. Returns true only if |fence|
+    // is currently in mInWait and requires waitNotInUse(). Safe under global mMutex.
+    bool removePending(VkFence fence) {
         std::lock_guard<std::mutex> lock(mMutex);
         for (size_t i = 0; i < mPending.size(); ++i) {
             if (mPending[i].fence == fence) {
                 mPending.erase(mPending.begin() + i);
-                return;
+                break;
             }
         }
+        for (VkFence f : mInWait) {
+            if (f == fence) return true;
+        }
+        return false;
     }
 
     // Waits until no native call on |fence| is in progress. Call outside global mMutex.
