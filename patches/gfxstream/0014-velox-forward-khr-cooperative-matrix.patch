+#ifdef VK_KHR_cooperative_matrix
+void marshal_VkCooperativeMatrixPropertiesKHR(
+    VulkanStream* vkStream, VkStructureType rootType,
+    const VkCooperativeMatrixPropertiesKHR* forMarshaling) {
+    (void)rootType;
+    vkStream->write((VkStructureType*)&forMarshaling->sType, sizeof(VkStructureType));
+    if (rootType == VK_STRUCTURE_TYPE_MAX_ENUM) {
+        rootType = forMarshaling->sType;
+    }
+    marshal_extension_struct(vkStream, rootType, forMarshaling->pNext);
+    vkStream->write((uint32_t*)&forMarshaling->MSize, sizeof(uint32_t));
+    vkStream->write((uint32_t*)&forMarshaling->NSize, sizeof(uint32_t));
+    vkStream->write((uint32_t*)&forMarshaling->KSize, sizeof(uint32_t));
+    vkStream->write((VkComponentTypeKHR*)&forMarshaling->AType, sizeof(VkComponentTypeKHR));
+    vkStream->write((VkComponentTypeKHR*)&forMarshaling->BType, sizeof(VkComponentTypeKHR));
+    vkStream->write((VkComponentTypeKHR*)&forMarshaling->CType, sizeof(VkComponentTypeKHR));
+    vkStream->write((VkComponentTypeKHR*)&forMarshaling->ResultType, sizeof(VkComponentTypeKHR));
+    vkStream->write((VkBool32*)&forMarshaling->saturatingAccumulation, sizeof(VkBool32));
+    vkStream->write((VkScopeKHR*)&forMarshaling->scope, sizeof(VkScopeKHR));
+}
+
+void unmarshal_VkCooperativeMatrixPropertiesKHR(VulkanStream* vkStream, VkStructureType rootType,
+                                                VkCooperativeMatrixPropertiesKHR* forUnmarshaling) {
+    (void)rootType;
+    vkStream->read((VkStructureType*)&forUnmarshaling->sType, sizeof(VkStructureType));
+    if (rootType == VK_STRUCTURE_TYPE_MAX_ENUM) {
+        rootType = forUnmarshaling->sType;
+    }
+    size_t pNext_size;
+    pNext_size = vkStream->getBe32();
+    forUnmarshaling->pNext = nullptr;
+    if (pNext_size) {
+        vkStream->alloc((void**)&forUnmarshaling->pNext, sizeof(VkStructureType));
+        vkStream->read((void*)forUnmarshaling->pNext, sizeof(VkStructureType));
+        VkStructureType extType = *(VkStructureType*)(forUnmarshaling->pNext);
+        vkStream->alloc((void**)&forUnmarshaling->pNext,
+                        goldfish_vk_extension_struct_size_with_stream_features(
+                            vkStream->getFeatureBits(), rootType, forUnmarshaling->pNext));
+        *(VkStructureType*)forUnmarshaling->pNext = extType;
+        unmarshal_extension_struct(vkStream, rootType, (void*)(forUnmarshaling->pNext));
+    }
+    vkStream->read((uint32_t*)&forUnmarshaling->MSize, sizeof(uint32_t));
+    vkStream->read((uint32_t*)&forUnmarshaling->NSize, sizeof(uint32_t));
+    vkStream->read((uint32_t*)&forUnmarshaling->KSize, sizeof(uint32_t));
+    vkStream->read((VkComponentTypeKHR*)&forUnmarshaling->AType, sizeof(VkComponentTypeKHR));
+    vkStream->read((VkComponentTypeKHR*)&forUnmarshaling->BType, sizeof(VkComponentTypeKHR));
+    vkStream->read((VkComponentTypeKHR*)&forUnmarshaling->CType, sizeof(VkComponentTypeKHR));
+    vkStream->read((VkComponentTypeKHR*)&forUnmarshaling->ResultType, sizeof(VkComponentTypeKHR));
+    vkStream->read((VkBool32*)&forUnmarshaling->saturatingAccumulation, sizeof(VkBool32));
+    vkStream->read((VkScopeKHR*)&forUnmarshaling->scope, sizeof(VkScopeKHR));
+}
+
+void marshal_VkPhysicalDeviceCooperativeMatrixFeaturesKHR(
+    VulkanStream* vkStream, VkStructureType rootType,
+    const VkPhysicalDeviceCooperativeMatrixFeaturesKHR* forMarshaling) {
+    (void)rootType;
+    vkStream->write((VkStructureType*)&forMarshaling->sType, sizeof(VkStructureType));
