+void unmarshal_VkPhysicalDeviceCooperativeMatrixPropertiesKHR(
+    VulkanStream* vkStream, VkStructureType rootType,
+    VkPhysicalDeviceCooperativeMatrixPropertiesKHR* forUnmarshaling) {
+    (void)rootType;
