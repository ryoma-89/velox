+int ReadBuffer::getPrefetchedData(RingStream* stream, size_t minSize) {
+    assert(stream);
+    assert(minSize > m_validData);
+    size_t len = 0;
+    const unsigned char* view = stream->acquirePrefetched(m_validData, minSize, &len);
+    if (!view || len < minSize || len > INT_MAX) return -1;
+    const size_t fresh = len - m_validData;
+    // The view stays valid until the next call; the decoders read and may write it in place.
+    m_readPtr = const_cast<unsigned char*>(view);
+    m_validData = len;
+    return static_cast<int>(fresh);
+}
+
 void ReadBuffer::consume(size_t amount) {
     assert(amount <= m_validData);
     m_validData -= amount;
