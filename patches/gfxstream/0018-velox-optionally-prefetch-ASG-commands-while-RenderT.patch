+// RenderThread receives directly until the stream holds |minSize| published bytes at |pos|.
+bool RingStream::receiveDirect(uint64_t pos, size_t minSize) {
+    ++mPrefetchTakeovers;
+    // Fast path: the prefetch thread is idle (the gate is closed for small round trips), so
+    // the rings are free and nothing has to be signalled.
+    std::unique_lock<std::mutex> reader(mRingReaderMutex, std::try_to_lock);
+    const bool contended = !reader.owns_lock();
+    if (contended) {
+        mConsumerWantsRing.store(true, std::memory_order_seq_cst);
+        // The prefetch thread lets go within one empty poll; it may also be mid-copy, or
+        // asleep in onUnavailableRead until the guest's next ping (then it publishes that
+        // data first).
+        const uint64_t budget = std::max<uint64_t>(asgSpinBudgetNs(), 20000);
+        const uint64_t start = monotonicNs();
+        while (!reader.try_lock()) {
+            if (monotonicNs() - start >= budget) {
+                ++mPrefetchTakeoverBlocks;
+                reader.lock();
+                break;
+            }
+            ring_buffer_yield();
+        }
+    }
+    // Release chunks behind |pos| so that receiving never waits on this thread itself.
+    consumerChunkFor(pos);
+    bool ok = true;
+    while (mPublishedEnd.load(std::memory_order_acquire) - pos < minSize) {
+        if (pumpPrefetch(false) < 0) {
+            ok = false;
+            break;
+        }
+    }
+    reader.unlock();
+    if (contended) mConsumerWantsRing.store(false, std::memory_order_seq_cst);
+    // With AHEAD=2 the gate is closed here (RenderThread is between views); consumerBusy()
+    // wakes the prefetch thread when it opens.
+    if (mPrefetchAhead != 2 && mProducerWaiting.load(std::memory_order_seq_cst)) {
+        std::lock_guard<std::mutex> lock(mPrefetchMutex);
+        mProducerCv.notify_one();
+    }
+    return ok;
+}
