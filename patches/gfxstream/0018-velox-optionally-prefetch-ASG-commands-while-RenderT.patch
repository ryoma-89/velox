+// A request that crosses a chunk boundary (only when the decoders asked for more than the
+// complete packets of a sealed chunk, e.g. after an unknown opcode) is served from a copy.
+// The caller has made sure the bytes are published.
+const unsigned char* RingStream::joinPrefetched(uint64_t pos, size_t minSize) {
+    mJoinBuffer.resize(minSize);
+    size_t copied = 0;
+    std::lock_guard<std::mutex> lock(mPrefetchMutex);
+    for (const auto& chunk : mPrefetchChunks) {
+        if (copied == minSize) break;
+        const uint64_t from = pos + copied;
+        const uint64_t published = chunk->published.load(std::memory_order_acquire);
+        if (from < chunk->start || from >= published) continue;
+        const size_t take =
+            static_cast<size_t>(std::min<uint64_t>(published - from, minSize - copied));
+        memcpy(mJoinBuffer.data() + copied, chunk->data.get() + (from - chunk->start), take);
+        copied += take;
+    }
+    if (copied != minSize) return nullptr;
+    ++mPrefetchJoins;
+    mPrefetchJoinBytes += minSize;
+    mConsViewEnd = pos + minSize;
+    return mJoinBuffer.data();
+}
+
+const unsigned char* RingStream::acquirePrefetched(size_t unconsumed, size_t minSize,
+                                                   size_t* outLen) {
+    if (!startPrefetch()) return nullptr;
+    if (unconsumed > mConsViewEnd) {
+        protocolError();
+        return nullptr;
+    }
+    const uint64_t pos = mConsViewEnd - unconsumed;
+    ++mPrefetchAcquires;
+    mConsumerBusy.store(false, std::memory_order_release);
+    for (;;) {
+        if (exitRequested() || mPrefetchStop.load(std::memory_order_acquire)) return nullptr;
+        if (PrefetchChunk* chunk = consumerChunkFor(pos)) {
+            const uint64_t published = chunk->published.load(std::memory_order_acquire);
+            if (pos < chunk->start) {
+                protocolError();
+                return nullptr;
+            }
+            const uint64_t available = published > pos ? published - pos : 0;
+            if (available >= minSize) {
+                mConsViewEnd = published;
+                *outLen = static_cast<size_t>(available);
+                consumerBusy(*outLen);
+                return chunk->data.get() + (pos - chunk->start);
+            }
+            if (chunk->sealed.load(std::memory_order_acquire) &&
+                mPublishedEnd.load(std::memory_order_acquire) - pos >= minSize) {
+                if (const unsigned char* joined = joinPrefetched(pos, minSize)) {
+                    *outLen = minSize;
+                    consumerBusy(minSize);
+                    return joined;
+                }
+                protocolError();
+                return nullptr;
+            }
+            if (mPublishedEnd.load(std::memory_order_acquire) - pos >= minSize) continue;
+        }
+        ++mPrefetchMisses;
+        if (!receiveDirect(pos, minSize)) return nullptr;
+    }
+}
