+// ---------------------------------------------------------------------------------------------
+// Velox receive prefetch (VELOX_ASG_PREFETCH=1).
+//
+// readRing() (the serial receive path, with all of its ring, transfer and host_state handling)
+// now writes into the tail of a host-private chunk. The bytes are framed by the packet length
+// at offset 4, and the end of the last complete packet is published. A packet never straddles
+// two chunks: when the packet being received does not fit, its received bytes move to a new
+// chunk before they are published. RenderThread decodes published bytes in place and releases
+// a chunk once it has moved past it, so the decoder never sees guest-writable memory and
+// nothing is copied a second time.
+//
+// One reader at a time owns the rings (mRingReaderMutex guards readRing() and the framing
+// state). While RenderThread decodes, the prefetch thread reads ahead. When RenderThread runs
+// out of published packets it takes the rings over (the prefetch thread gives them up while it
+// polls an empty ring) and receives directly, as the serial path does, so a synchronous round
+// trip does not pay a thread hand-off. Replies (commitBuffer) stay on RenderThread unchanged.
+// ---------------------------------------------------------------------------------------------
+
+bool RingStream::producerShouldYield() const {
+    return mConsumerWantsRing.load(std::memory_order_acquire) ||
+           (mPrefetchAhead == 2 && !mConsumerBusy.load(std::memory_order_acquire));
+}
+
+// RenderThread is about to decode a view: with VELOX_ASG_PREFETCH_AHEAD=2 the prefetch thread
+// reads ahead from now until RenderThread asks for data again, if the view is large.
+void RingStream::consumerBusy(size_t viewSize) {
+    if (mPrefetchAhead == 2 && viewSize < mPrefetchMinView) return;
+    ++mPrefetchGateOpens;
+    mConsumerBusy.store(true, std::memory_order_seq_cst);
+    if (mPrefetchAhead == 2 && mProducerWaiting.load(std::memory_order_seq_cst)) {
+        std::lock_guard<std::mutex> lock(mPrefetchMutex);
+        mProducerCv.notify_one();
+    }
+}
+
+bool RingStream::prefetchStopping() const {
+    return mShouldExit.load(std::memory_order_acquire) ||
+           mPrefetchStop.load(std::memory_order_acquire);
+}
+
+void RingStream::wakePrefetchWaiters() {
+    std::lock_guard<std::mutex> lock(mPrefetchMutex);
+    mProducerCv.notify_all();
+}
+
+bool RingStream::startPrefetch() {
+    if (mPrefetchStarted) return true;
+    if (prefetchStopping()) return false;
+    // The first chunk exists before either reader runs. The client flags are framed as a
+    // packet of their own.
+    mProdChunk = newPrefetchChunk(0, 0);
+    if (!mProdChunk) return false;
+    mProdWritten = 0;
+    mFrameNext = 0;
+    mFrameEnd = kStreamFlagsSize;
+    mPrefetchStarted = true;
+    if (mPrefetchAhead) mPrefetchThread = std::thread([this] { prefetchMain(); });
+    return true;
+}
+
+void RingStream::stopPrefetch(bool join) {
+    if (!mPrefetchWanted) return;
+    mPrefetchStop.store(true, std::memory_order_release);
+    wakePrefetchWaiters();
+    if (join && mPrefetchThread.joinable() &&
+        mPrefetchThread.get_id() != std::this_thread::get_id()) {
+        mPrefetchThread.join();
+    }
+}
+
+RingStream::PrefetchChunk* RingStream::newPrefetchChunk(uint64_t start, uint64_t minCapacity) {
+    const uint64_t wanted = std::max<uint64_t>(minCapacity, mPrefetchChunkSize);
+    const uint64_t capacity = (wanted + kPrefetchChunkAlign - 1) & ~(kPrefetchChunkAlign - 1);
+    std::unique_ptr<PrefetchChunk> chunk;
+    {
+        std::lock_guard<std::mutex> lock(mPrefetchMutex);
+        if (capacity == mPrefetchChunkSize && !mFreeChunks.empty()) {
+            chunk = std::move(mFreeChunks.back());
+            mFreeChunks.pop_back();
+        }
+    }
+    if (!chunk) {
+        chunk = std::make_unique<PrefetchChunk>();
+        chunk->data.reset(new (std::nothrow) unsigned char[capacity]);
+        if (!chunk->data) {
+            GFXSTREAM_ERROR("VELOX_ASG_PREFETCH: failed to allocate %llu bytes",
+                            static_cast<unsigned long long>(capacity));
+            protocolError();
+            return nullptr;
+        }
+        chunk->capacity = capacity;
+    }
+    chunk->start = start;
+    chunk->published.store(start, std::memory_order_relaxed);
+    chunk->sealed.store(false, std::memory_order_relaxed);
+    PrefetchChunk* result = chunk.get();
+    {
+        std::lock_guard<std::mutex> lock(mPrefetchMutex);
+        mPrefetchChunks.push_back(std::move(chunk));
+    }
+    return result;
+}
+
+bool RingStream::rollPrefetchChunk(uint64_t minCapacity) {
+    PrefetchChunk* old = mProdChunk;
+    const uint64_t partial = mProdWritten - mFrameNext;
+    PrefetchChunk* next = newPrefetchChunk(mFrameNext, std::max(minCapacity, partial));
+    if (!next) return false;
+    if (partial) {
+        memcpy(next->data.get(), old->data.get() + (mFrameNext - old->start), partial);
+        mPrefetchRelocatedBytes += partial;
+    }
+    ++mPrefetchRolls;
+    // |old| is published up to mFrameNext; RenderThread moves on once it sees the seal.
+    old->sealed.store(true, std::memory_order_release);
+    mProdChunk = next;
+    return true;
+}
+
+bool RingStream::framePrefetched() {
+    PrefetchChunk* chunk = mProdChunk;
+    for (;;) {
+        if (!mFrameEnd) {
+            if (mProdWritten - mFrameNext < kPacketHeaderSize) break;
+            uint32_t packetSize = 0;
+            memcpy(&packetSize, chunk->data.get() + (mFrameNext - chunk->start) + 4,
+                   sizeof(packetSize));
+            // A length below the header is still handed to the decoders, which reject it.
+            const uint64_t framed = std::max<uint64_t>(packetSize, kPacketHeaderSize);
+            if (framed > kMaxPrefetchPacket) {
+                GFXSTREAM_ERROR("VELOX_ASG_PREFETCH: packet length %u exceeds %llu", packetSize,
+                                static_cast<unsigned long long>(kMaxPrefetchPacket));
+                protocolError();
+                return false;
+            }
+            mFrameEnd = mFrameNext + framed;
+        }
+        if (mFrameEnd > mProdWritten) break;
+        mFrameNext = mFrameEnd;
+        mFrameEnd = 0;
+    }
+    if (mFrameNext > chunk->published.load(std::memory_order_relaxed)) {
+        chunk->published.store(mFrameNext, std::memory_order_release);
+        mPublishedEnd.store(mFrameNext, std::memory_order_release);
+    }
+    const uint64_t chunkEnd = chunk->start + chunk->capacity;
+    const uint64_t needed = mFrameEnd ? mFrameEnd : mFrameNext + kPacketHeaderSize;
+    if (needed > chunkEnd) return rollPrefetchChunk(needed - mFrameNext);
+    return true;
+}
+
+// One receive step by the current ring owner. 1: bytes received, 0: nothing (the prefetch
+// thread gave the rings up), -1: readRing() returned early (exit, error or snapshot).
+int RingStream::pumpPrefetch(bool producer) {
+    PrefetchChunk* chunk = mProdChunk;
+    const uint64_t used = mProdWritten - chunk->start;
+    size_t len = static_cast<size_t>(chunk->capacity - used);
+    if (!len) return rollPrefetchChunk(0) ? 0 : -1;
+    mReaderIsProducer = producer;
+    const unsigned char* got = readRing(chunk->data.get() + used, &len);
+    mReaderIsProducer = false;
+    if (!got) return -1;
+    if (!len) return 0;
+    mProdWritten += len;
+    if (producer) {
+        ++mPrefetchProducerReads;
+        mPrefetchProducerBytes += len;
+    } else {
+        ++mPrefetchDirectReads;
+        mPrefetchDirectBytes += len;
+    }
+    return framePrefetched() ? 1 : -1;
+}
+
+void RingStream::prefetchIdle(bool* sleeping) {
+    const uint64_t takeoverBudget = 4 * std::max<uint64_t>(asgSpinBudgetNs(), 20000);
+    constexpr uint64_t kClosedGateBudget = 2000;
+    const uint64_t start = monotonicNs();
+    while ((producerShouldYield() || mInSnapshotOperation.load(std::memory_order_acquire)) &&
+           !prefetchStopping()) {
+        const bool takeover = mConsumerWantsRing.load(std::memory_order_acquire);
+        if (monotonicNs() - start < (takeover ? takeoverBudget : kClosedGateBudget)) {
+            ring_buffer_yield();
+            continue;
+        }
+        *sleeping = true;
+        std::unique_lock<std::mutex> lock(mPrefetchMutex);
+        mProducerWaiting.store(true, std::memory_order_seq_cst);
+        if (producerShouldYield() || mInSnapshotOperation.load(std::memory_order_seq_cst)) {
+            mProducerCv.wait_for(lock, std::chrono::milliseconds(2));
+        }
+        mProducerWaiting.store(false, std::memory_order_relaxed);
+    }
+}
+
+void RingStream::prefetchMain() {
+    while (!prefetchStopping()) {
+        // RenderThread takes priority for the rings; a pending snapshot stops the read-ahead
+        // (RenderThread still receives on demand, as the serial path does).
+        if (producerShouldYield() || mInSnapshotOperation.load(std::memory_order_acquire)) {
+            bool slept = false;
+            prefetchIdle(&slept);
+            if (slept) ++mPrefetchProducerSleeps;
+            continue;
+        }
+        {
+            // Read ahead at most mPrefetchMaxChunks chunks (a roll inside one step may add one).
+            std::unique_lock<std::mutex> lock(mPrefetchMutex);
+            if (mPrefetchChunks.size() >= mPrefetchMaxChunks) {
+                ++mPrefetchProducerStalls;
+                mProducerWaiting.store(true, std::memory_order_seq_cst);
+                mProducerCv.wait_for(lock, std::chrono::milliseconds(2));
+                mProducerWaiting.store(false, std::memory_order_relaxed);
+                continue;
+            }
+        }
+        std::unique_lock<std::mutex> reader(mRingReaderMutex, std::try_to_lock);
+        if (!reader.owns_lock()) {
+            ring_buffer_yield();
+            continue;
+        }
+        if (producerShouldYield()) continue;
+        if (pumpPrefetch(true) < 0) {
+            reader.unlock();
+            if (prefetchStopping()) break;
+            // A snapshot is pending; readRing() returns early until it resumes.
+            gfxstream::base::sleepUs(1000);
+        }
+    }
+    exitRequested();  // publishes ASG_HOST_STATE_EXIT if that is why the loop ended
+}
+
+RingStream::PrefetchChunk* RingStream::consumerChunkFor(uint64_t pos) {
+    PrefetchChunk* chunk = mConsChunk;
+    if (chunk && (!chunk->sealed.load(std::memory_order_acquire) ||
+                  pos < chunk->published.load(std::memory_order_acquire))) {
+        return chunk;
+    }
+    std::vector<std::unique_ptr<PrefetchChunk>> released;
+    {
+        std::lock_guard<std::mutex> lock(mPrefetchMutex);
+        bool freed = false;
+        while (mPrefetchChunks.size() > 1) {
+            PrefetchChunk* front = mPrefetchChunks.front().get();
+            if (!front->sealed.load(std::memory_order_acquire) ||
+                front->published.load(std::memory_order_acquire) > pos) {
+                break;
+            }
