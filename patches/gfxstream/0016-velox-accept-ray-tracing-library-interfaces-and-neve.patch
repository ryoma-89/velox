diff --git a/host/vulkan/velox_trace.h b/host/vulkan/velox_trace.h
new file mode 100644
index 0000000..a467417
--- /dev/null
+++ b/host/vulkan/velox_trace.h
@@ -0,0 +1,39 @@
+// Velox: durable diagnostic trace for host crashes (KI-31).
+//
+// Enabled only when VELOX_VK_TRACE_FILE names a file. Each line is flushed so the history before a
+// crash in the host process (or in the Vulkan driver it calls) survives the crash.
+#pragma once
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace gfxstream {
+namespace host {
+namespace vk {
+
+inline FILE* veloxTraceFile() {
+    static FILE* file = []() -> FILE* {
+        const char* path = std::getenv("VELOX_VK_TRACE_FILE");
+        return path && *path ? std::fopen(path, "a") : nullptr;
+    }();
+    return file;
+}
+
+inline void veloxTrace(const char* format, ...) {
+    FILE* file = veloxTraceFile();
+    if (!file) return;
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    va_list args;
+    va_start(args, format);
+    std::vfprintf(file, format, args);
+    va_end(args);
+    std::fputc('\n', file);
+    std::fflush(file);
+}
+
+}  // namespace vk
+}  // namespace host
+}  // namespace gfxstream
