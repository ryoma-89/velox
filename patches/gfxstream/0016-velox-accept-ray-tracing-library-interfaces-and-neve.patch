+// Velox: a guest can pass VK_NULL_HANDLE (or a pipeline whose creation failed); the NVIDIA driver
+// dereferences the pipeline here (KI-31). Reject it instead of calling the driver.
+VkResult VkDecoderGlobalState::on_vkGetRayTracingShaderGroupHandlesKHR(
+    gfxstream::base::BumpPool*, VkSnapshotApiCallHandle, VkDevice boxed_device, VkPipeline pipeline,
+    uint32_t firstGroup, uint32_t groupCount, size_t dataSize, void* pData) {
+    auto device = unbox_VkDevice(boxed_device);
+    auto vk = dispatch_VkDevice(boxed_device);
+    veloxTrace("D get-handles device=%p pipeline=%p first=%u count=%u size=%zu", device, pipeline,
+               firstGroup, groupCount, dataSize);
+    if (pipeline == VK_NULL_HANDLE) {
+        if (pData && dataSize) memset(pData, 0, dataSize);
+        GFXSTREAM_ERROR("vkGetRayTracingShaderGroupHandlesKHR: null pipeline");
+        return VK_ERROR_UNKNOWN;
+    }
+    return vk->vkGetRayTracingShaderGroupHandlesKHR(device, pipeline, firstGroup, groupCount,
+                                                    dataSize, pData);
+}
+
+VkDeviceSize VkDecoderGlobalState::on_vkGetRayTracingShaderGroupStackSizeKHR(
+    gfxstream::base::BumpPool*, VkSnapshotApiCallHandle, VkDevice boxed_device, VkPipeline pipeline,
+    uint32_t group, VkShaderGroupShaderKHR groupShader) {
+    auto device = unbox_VkDevice(boxed_device);
+    auto vk = dispatch_VkDevice(boxed_device);
+    if (pipeline == VK_NULL_HANDLE) {
+        GFXSTREAM_ERROR("vkGetRayTracingShaderGroupStackSizeKHR: null pipeline");
+        return 0;
+    }
+    return vk->vkGetRayTracingShaderGroupStackSizeKHR(device, pipeline, group, groupShader);
+}
