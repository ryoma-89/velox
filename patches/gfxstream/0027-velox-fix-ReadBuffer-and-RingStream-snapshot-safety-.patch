diff --git a/host/address_space/sub_allocator.cpp b/host/address_space/sub_allocator.cpp
index 36eb749..329fe30 100644
--- a/host/address_space/sub_allocator.cpp
+++ b/host/address_space/sub_allocator.cpp
@@ -86,9 +86,22 @@ public:
         address_space_allocator_iter_func_t allocatorLoader =
             [](void* context, struct address_space_allocator* allocator) {
                 Stream* stream = reinterpret_cast<Stream*>(context);
-                allocator->size = stream->getBe32();
-                allocator->capacity = stream->getBe32();
-                allocator->total_bytes = stream->getBe64();
+                int savedSize = static_cast<int>(stream->getBe32());
+                int savedCapacity = static_cast<int>(stream->getBe32());
+                uint64_t savedTotalBytes = stream->getBe64();
+                if (savedCapacity < savedSize) {
+                    savedCapacity = savedSize;
+                }
+                if (savedCapacity > allocator->capacity) {
+                    allocator->blocks = static_cast<struct address_block*>(
+                        address_space_realloc(
+                            allocator->blocks,
+                            sizeof(struct address_block) * static_cast<size_t>(savedCapacity)));
+                    address_space_assert(allocator->blocks != nullptr);
+                }
+                allocator->size = savedSize;
+                allocator->capacity = savedCapacity;
+                allocator->total_bytes = savedTotalBytes;
             };
         address_block_iter_func_t allocatorBlockLoader =
             [](void* context, struct address_block* block) {
diff --git a/host/read_buffer.cpp b/host/read_buffer.cpp
index d6135ee..5cbdb26 100644
--- a/host/read_buffer.cpp
+++ b/host/read_buffer.cpp
@@ -126,28 +126,74 @@ void ReadBuffer::consume(size_t amount) {
     m_readPtr += amount;
 }
 
+namespace {
+// Upper bound for snapshot-serialized ReadBuffer capacity/data (1 GiB, matching RingStream).
+constexpr size_t kMaxSnapshotReadBufferBytes = 1024ull * 1024ull * 1024ull;
+}  // namespace
+
 void ReadBuffer::onSave(gfxstream::Stream* stream) {
-    stream->putBe32(m_size);
-    stream->putBe32(m_validData);
-    stream->write(m_readPtr, m_validData);
+    size_t saveValid = m_validData;
+    if (saveValid > 0 && m_readPtr == nullptr) {
+        GFXSTREAM_ERROR("ReadBuffer::onSave: null m_readPtr with m_validData=%zu\n", saveValid);
+        saveValid = 0;
+    }
+    // Velox VELOX_ASG_PREFETCH: getPrefetchedData() points m_readPtr into a prefetch chunk
+    // whose view length (m_validData) may exceed the initial malloc capacity (m_size, 128 KiB).
+    // Serialize a capacity at least as large as saveValid so onLoad() never drops unconsumed
+    // bytes or desynchronizes the snapshot stream.
+    size_t saveSize = std::max(m_size, saveValid);
+    if (saveValid > kMaxSnapshotReadBufferBytes) {
+        GFXSTREAM_ERROR("ReadBuffer::onSave: m_validData=%zu exceeds limit %zu\n",
+                        saveValid, kMaxSnapshotReadBufferBytes);
+        saveValid = 0;
+        saveSize = std::min(m_size, kMaxSnapshotReadBufferBytes);
+    } else if (saveSize > kMaxSnapshotReadBufferBytes) {
+        saveSize = kMaxSnapshotReadBufferBytes;
+    }
+    stream->putBe32(static_cast<uint32_t>(saveSize));
+    stream->putBe32(static_cast<uint32_t>(saveValid));
+    if (saveValid > 0) {
+        stream->write(m_readPtr, saveValid);
+    }
 }
 
 void ReadBuffer::onLoad(gfxstream::Stream* stream) {
-    const auto size = stream->getBe32();
-    if (size > m_size) {
-        m_size = size;
+    const uint32_t savedSize = stream->getBe32();
+    const uint32_t savedValid = stream->getBe32();
+    if (savedSize > kMaxSnapshotReadBufferBytes || savedValid > savedSize) {
+        GFXSTREAM_ERROR("ReadBuffer::onLoad: invalid savedValid=%u savedSize=%u\n",
+                        savedValid, savedSize);
+        m_readPtr = m_buf;
+        m_validData = 0;
+        return;
+    }
+    if (savedSize > m_size) {
+        unsigned char* newBuf = static_cast<unsigned char*>(malloc(savedSize));
+        if (!newBuf) {
+            GFXSTREAM_ERROR("ReadBuffer::onLoad: failed to alloc %u bytes\n", savedSize);
+            m_readPtr = m_buf;
+            m_validData = 0;
+            return;
+        }
         free(m_buf);
-        m_buf = (unsigned char*)malloc(m_size);
+        m_buf = newBuf;
+        m_size = savedSize;
     }
     m_readPtr = m_buf;
-    m_validData = stream->getBe32();
-    if (m_buf == nullptr || m_validData > m_size) {
-        GFXSTREAM_ERROR("ReadBuffer::onLoad: invalid m_validData=%zu m_size=%zu\n",
-                        m_validData, m_size);
+    if (m_buf == nullptr) {
+        GFXSTREAM_ERROR("ReadBuffer::onLoad: null m_buf (m_size=%zu)\n", m_size);
         m_validData = 0;
         return;
     }
-    stream->read(m_readPtr, m_validData);
+    if (savedValid > 0) {
+        const ssize_t got = stream->read(m_readPtr, savedValid);
+        if (got < 0 || static_cast<size_t>(got) != savedValid) {
+            GFXSTREAM_ERROR("ReadBuffer::onLoad: short read %zd / %u bytes\n", got, savedValid);
+            m_validData = 0;
+            return;
+        }
+    }
+    m_validData = savedValid;
 }
 
 }  // namespace host
