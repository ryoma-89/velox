+    gfxstream::base::BumpPool*, VkSnapshotApiCallHandle, VkDevice boxed_device,
+    VkAccelerationStructureBuildTypeKHR buildType,
+    const VkAccelerationStructureBuildGeometryInfoKHR* pBuildInfo,
+    const uint32_t* pMaxPrimitiveCounts, VkAccelerationStructureBuildSizesInfoKHR* pSizeInfo) {
+    pSizeInfo->accelerationStructureSize = 0;
+    pSizeInfo->updateScratchSize = 0;
+    pSizeInfo->buildScratchSize = 0;
+    if (!pBuildInfo || buildType != VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR) {
+        GFXSTREAM_ERROR("vkGetAccelerationStructureBuildSizesKHR: only device builds are exposed");
+        return;
+    }
+    if (pBuildInfo->geometryCount && (!pBuildInfo->pGeometries || !pMaxPrimitiveCounts)) {
+        GFXSTREAM_ERROR("vkGetAccelerationStructureBuildSizesKHR: missing geometry arrays");
+        return;
+    }
+    // Never transferred; the guest always sends the geometries in pGeometries.
+    const_cast<VkAccelerationStructureBuildGeometryInfoKHR*>(pBuildInfo)->ppGeometries = nullptr;
+    auto device = unbox_VkDevice(boxed_device);
+    auto vk = dispatch_VkDevice(boxed_device);
+    vk->vkGetAccelerationStructureBuildSizesKHR(device, buildType, pBuildInfo,
+                                                pMaxPrimitiveCounts, pSizeInfo);
