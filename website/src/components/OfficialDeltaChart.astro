---
import type { Locale } from '../data/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const items = [
  {
    label: { ja: 'Vulkan Draw Call (6 vCPU 同条件)', en: 'Vulkan Draw Call (Same 6 vCPU)' },
    sdkVal: '299.8 fps',
    veloxVal: '1,603.8 fps',
    sdkPct: 18.7,
    veloxPct: 100,
    ratio: '5.35×',
    note: { ja: 'vk-render draws / 3 回中央値 / チェックサム一致', en: 'vk-render draws / 3-run median / checksum verified' },
  },
  {
    label: { ja: 'Vulkan 同期 (6 vCPU 同条件)', en: 'Vulkan Sync (Same 6 vCPU)' },
    sdkVal: '4,340 fps',
    veloxVal: '12,712 fps',
    sdkPct: 34.1,
    veloxPct: 100,
    ratio: '2.93×',
    note: { ja: 'vk-render sync / 3 回中央値 / 最大 12,841.5 fps', en: 'vk-render sync / 3-run median / peak 12,841.5 fps' },
  },
  {
    label: { ja: 'CPU 整数 MT (公式 6T 上限 vs 20T 解放)', en: 'CPU Integer MT (6T Cap vs 20T Unlocked)' },
    sdkVal: '8.60 Gops/s',
    veloxVal: '23.35 Gops/s',
    sdkPct: 36.8,
    veloxPct: 100,
    ratio: '2.71×',
    note: { ja: '同 6T では同等 (8.61 Gops/s)。Patch 0001 で 20 vCPU 解放', en: 'Parity at 6T (8.61 Gops/s). Patch 0001 unlocks 20 vCPUs' },
  },
  {
    label: { ja: '120 fps Vulkan 1% Low (vk-game_demo)', en: '120 fps Vulkan 1% Low (vk-game_demo)' },
    sdkVal: '105.65 fps',
    veloxVal: '119.11 fps',
    sdkPct: 88.1,
    veloxPct: 99.3,
    ratio: '+13.5 fps',
    note: { ja: 'QEMU Patch 0013/0015 高精度タイマー待機 (stutter 0)', en: 'QEMU Patches 0013/0015 high-res timer wait (0 stutters)' },
  },
  {
    label: { ja: 'GPU Upload 64 MiB E2E (Type 2 特定経路)', en: 'GPU Upload 64 MiB E2E (Type 2 Path)' },
    sdkVal: '0.31 GB/s',
    veloxVal: '14.14 GB/s',
    sdkPct: 2.2,
    veloxPct: 100,
    ratio: '45.6×*',
    note: { ja: '*Cached Staging 特定経路の値（GPU 全体の倍率ではない）', en: '*Scoped to Cached Staging upload path (not whole-GPU speedup)' },
  },
  {
    label: { ja: '同期 RPC レイテンシ (低いほど高速)', en: 'Sync RPC Latency (lower is faster)' },
    sdkVal: '40.14 µs',
    veloxVal: '0.80 µs',
    sdkPct: 100,
    veloxPct: 2.0,
    ratio: '50.1×*',
    note: { ja: '*pipe → ASG 共有メモリ単発 RPC 短縮（全体速度ではない）', en: '*Single sync RPC reduction pipe → ASG (not whole-emulator speed)' },
  },
];
---

<div class="panel">
  <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;">
    <h3 style="margin:0;">
      {locale === 'ja' ? 'Google 公式 SDK 37.3.10 vs Velox 第 20 段階（同一 PC・同一 Android 17 直接実測）' : 'Google Official SDK 37.3.10 vs Velox Phase 20 (Same PC & Android 17 Direct Run)'}
    </h3>
    <div style="display:flex;gap:14px;font-size:12.5px;color:var(--text-muted);">
      <span style="display:inline-flex;align-items:center;gap:6px;">
        <i style="width:10px;height:10px;border-radius:2px;background:#475569;display:inline-block;"></i>
        {locale === 'ja' ? '公式 SDK 37.3.10 (6 vCPU)' : 'Official SDK 37.3.10 (6 vCPU)'}
      </span>
      <span style="display:inline-flex;align-items:center;gap:6px;">
        <i style="width:10px;height:10px;border-radius:2px;background:var(--accent);display:inline-block;"></i>
        {locale === 'ja' ? 'Velox 第 20 段階' : 'Velox Phase 20'}
      </span>
    </div>
  </div>

  <div class="delta-list">
    {items.map((it) => (
      <div class="delta-item">
        <div class="delta-head">
          <strong>{it.label[locale]}</strong>
          <span class="badge badge-blue mono">{it.ratio}</span>
        </div>
        <div class="delta-bars">
          <div class="delta-bar-row">
            <span class="delta-tag">{locale === 'ja' ? '公式 SDK' : 'Official'}</span>
            <div class="bar-track" style="flex:1;height:10px;">
              <div class="bar-fill" style={`width:${it.sdkPct}%;background:#475569;`}></div>
            </div>
            <span class="mono delta-num">{it.sdkVal}</span>
          </div>
          <div class="delta-bar-row">
            <span class="delta-tag" style="color:var(--accent-light);">Velox P20</span>
            <div class="bar-track" style="flex:1;height:10px;">
              <div class="bar-fill" style={`width:${it.veloxPct}%;background:var(--accent);`}></div>
            </div>
            <span class="mono delta-num" style="color:#fff;font-weight:600;">{it.veloxVal}</span>
          </div>
        </div>
        <div class="bar-meta">{it.note[locale]}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .delta-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 24px;
  }
  .delta-item {
    padding: 14px 16px;
    background: #0a101e;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: grid;
    gap: 8px;
  }
  .delta-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .delta-bars {
    display: grid;
    gap: 6px;
  }
  .delta-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .delta-tag {
    width: 68px;
    font-size: 12px;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .delta-num {
    width: 96px;
    text-align: right;
    font-size: 12.5px;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  @media (max-width: 820px) {
    .delta-list {
      grid-template-columns: 1fr;
    }
  }
</style>
