---
import { dataset } from '../data/benchmarks';
import type { Locale } from '../data/schema';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const env = dataset.testEnvironment;
---

<div class="native-chart-wrap">
  <div class="native-legend">
    <span>
      <i class="dot" style="background:var(--accent);"></i>
      {locale === 'ja' ? 'Velox 第 20 段階 (v0.3.0)' : 'Velox Phase 20 (v0.3.0)'}
    </span>
    <span>
      <i class="dot" style="background:var(--green);"></i>
      {locale === 'ja' ? 'Windows ネイティブ = 100% 基準線' : 'Windows Native = 100% reference line'}
    </span>
  </div>

  <div class="bar-chart" role="list" aria-label={locale === 'ja' ? 'Windows ネイティブ比性能グラフ' : 'Performance vs Windows Native'}>
    {dataset.nativeComparison.map((item) => {
      const pct = Math.min(100, Math.max(0, item.nativePercent));
      return (
        <div class="bar-row" role="listitem">
          <div class="bar-row-head">
            <strong>{item.label[locale]}</strong>
            <span class="mono" style="color:#fff;">
              <strong style="color:var(--accent-light);">{item.nativePercent.toFixed(1)}%</strong>
              <span style="color:var(--text-muted);margin-left:8px;">
                {item.veloxValue} / {item.nativeValue}
              </span>
            </span>
          </div>
          <div class="bar-track" style="height:14px;">
            <div
              class="bar-fill"
              style={`width:${pct}%;background:${pct >= 95 ? 'linear-gradient(90deg,#2563eb,#38bdf8)' : 'var(--accent)'};`}
            ></div>
            <div class="native-ref-line" title="Windows Native 100%"></div>
          </div>
          {!compact && (
            <div class="bar-meta">
              {item.note[locale]} — <span class="mono">{item.source}</span>
            </div>
          )}
        </div>
      );
    })}
  </div>

  <div class="env-strip">
    <div class="env-title">
      {locale === 'ja' ? '測定環境（同一 PC・WHPX / VBS 有効のまま無改変）' : 'Test Environment (Same PC, WHPX & VBS enabled unmodified)'}
    </div>
    <div class="env-grid">
      <span><strong>CPU:</strong> {env.cpu}</span>
      <span><strong>GPU:</strong> {env.gpu} (Driver {env.gpuDriver})</span>
      <span><strong>RAM:</strong> {env.ram}</span>
      <span><strong>OS:</strong> {env.os} ({env.virtualization})</span>
    </div>
  </div>

  <div class="callout" style="margin-top:14px;">
    <strong>{locale === 'ja' ? '測定範囲に関する注記:' : 'Scope Notice:'}</strong>{' '}
    {locale === 'ja'
      ? '上記の比率は、同一ソースコードを Windows ネイティブと Android ゲストでビルド・検算した独立ベンチマークの実測結果です。実ゲーム全般のフレームレートが一律にこの比率となることを保証するものではありません。'
      : 'These ratios come from independent, checksum-verified benchmarks compiled from identical source code on Windows Native and Android guest. They do not guarantee identical FPS ratios across all commercial games.'}
  </div>
</div>

<style>
  .native-chart-wrap {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .native-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 18px;
  }
  .native-legend span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .native-ref-line {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--green);
  }
  .env-strip {
    margin-top: 22px;
    padding: 14px 16px;
    background: #080d19;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 13px;
  }
  .env-title {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }
  .env-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 18px;
    color: var(--text-muted);
  }
  @media (max-width: 720px) {
    .env-grid {
      grid-template-columns: 1fr;
    }
    .native-chart-wrap {
      padding: 16px;
    }
  }
</style>
