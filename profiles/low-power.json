{
  "avd": {
    "name": "velox-main",
    "sysdir": null,
    "home": null,
    "api_level": 37,
    "abi": "x86_64",
    "tag": "google_apis"
  },
  "cpu": {
    "cores": 4,
    "affinity": "E",
    "priority": "normal",
    "disable_power_throttling": false,
    "smp_override": false,
    "thread_placement": {}
  },
  "memory": {
    "ram_mb": 6144,
    "vm_heap_mb": 512,
    "data_partition_gb": 32,
    "guest_thp": "madvise"
  },
  "gpu": {
    "mode": "host",
    "features": [
      "VulkanBatchedDescriptorSetUpdate"
    ],
    "disable_implicit_vk_layers": true,
    "vulkan_1_4": false,
    "gfxstream_features": [],
    "transport": "asg",
    "host_env": {
      "VELOX_ASG_SPIN_US": "20",
      "VELOX_VK_FLUSH_NO_COPY": "1",
      "VELOX_VK_CACHED_UPLOAD": "1",
      "VELOX_FENCE_SHARED": "1",
      "VELOX_WHPX_PRERUN_FAST": "1",
      "VELOX_WIN32_AIO_POOL": "1"
    },
    "guest_props": {
      "debug.velox.cmd_stream_kb": "128",
      "debug.velox.cmd_stream_first_kb": "2",
      "debug.velox.fence_shared": "1",
      "debug.velox.ray_tracing": "1",
      "debug.velox.ray_tracing_pipeline": "1",
      "debug.velox.cooperative_matrix": "1"
    },
    "host_validation": null
  },
  "display": {
    "width": 1280,
    "height": 720,
    "density": 240,
    "refresh_hz": 60,
    "frame_rate_mode": "standard",
    "fps_limit": 60
  },
  "boot": {
    "snapshot": false,
    "window": true,
    "audio": true,
    "kernel_params": "clocksource=tsc"
  },
  "emulator": {
    "dir": null
  },
  "extra_args": [
    "-no-snapstorage",
    "-no-metrics"
  ]
}
